  userId  String
  user    User        @relation("TaggedUsers", fields: [userId], references: [id], onDelete: Cascade)
  eventId String? // Optional: tag specific to an event
  event   Event?      @relation("EventTaggedUsers", fields: [eventId], references: [id], onDelete: Cascade)

  taggedBy String? // User ID who added the tag
  notes    String? @db.Text

  createdAt DateTime @default(now())

  @@unique([tagId, userId, eventId])
  @@index([tagId])
  @@index([userId])
  @@index([eventId])
}

// Advanced Promo Code Features
model PromoCodeVariant {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation("PromoCodeVariants", fields: [promoCodeId], references: [id], onDelete: Cascade)


// Event Expenses
model EventExpense {
  id          String  @id @default(uuid())
  organizerId String
  organizer   User    @relation("OrganizerExpenses", fields: [organizerId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?  @relation("EventExpenses", fields: [eventId], references: [id], onDelete: Cascade)

  category    String // e.g., "Marketing", "Venue", "Equipment", "Staff"
  description String  @db.Text
  amount      Decimal @db.Decimal(10, 2)
  currency    String  @default("NGN")

  // Receipt/Proof

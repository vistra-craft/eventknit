  mediaPlaceholders String[] // Media placeholder names (e.g., eventImage, logo)
  
  isPublic   Boolean  @default(false)
  usageCount Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizerId])
  @@index([platform])
  @@index([isPublic])
}

// ============================================
// Seating & Venue Map Models
// ============================================

enum SeatStatus {
  AVAILABLE    // Seat is available for booking
  RESERVED     // Seat is temporarily reserved (in cart)
  BOOKED       // Seat is booked/assigned
  BLOCKED      // Seat is blocked (not available)
  MAINTENANCE  // Seat is under maintenance
}

enum SeatType {
  STANDARD     // Standard seat
  VIP          // VIP seat
  PREMIUM      // Premium seat
  WHEELCHAIR   // Wheelchair accessible
  COMPANION    // Companion seat (for wheelchair users)
  STANDING     // Standing area
}

model Venue {
  id          String   @id @default(uuid())
  organizerId String
  organizer   User     @relation("OrganizerVenues", fields: [organizerId], references: [id], onDelete: Cascade)
  
  name        String
  description String?  @db.Text
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  coordinates Json?    // { lat: number, lng: number }
  
  // Venue details
  capacity    Int?     // Total capacity
  venueType   String?  // "theatre", "stadium", "conference", "hall", etc.
  amenities   String[] // Array of amenities
  
  // Default seating configuration
  defaultSeatMap Json? // Default seat map layout (can be overridden per event)
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  seatMaps    SeatMap[]
  
  @@index([organizerId])
  @@index([isActive])
  @@index([venueType])
}

model SeatMap {
  id          String   @id @default(uuid())
  eventId     String   @unique
  event       Event    @relation("EventSeatMap", fields: [eventId], references: [id], onDelete: Cascade)
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  
  // Seat map configuration
  name        String?  // Custom name for this seat map
  layout      Json     // Seat map layout configuration (sections, rows, seats)
  // Layout structure:
  // {
  //   sections: [
  //     {
  //       id: "section-1",
  //       name: "Orchestra",
  //       type: "seated",
  //       rows: [
  //         {
  //           id: "row-A",
  //           label: "A",
  //           seats: [
  //             { id: "A1", label: "1", type: "STANDARD", price: 50.00 },
  //             { id: "A2", label: "2", type: "VIP", price: 100.00 }
  //           ]
  //         }
  //       ]
  //     }
  //   ]
  // }
  
  // Pricing by section/type
  pricing     Json?    // Pricing configuration per section/seat type
  
  // Display settings
  imageUrl    String?  // Venue map image URL
  width       Int?     // Map width in pixels
  height      Int?     // Map height in pixels
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  seats       Seat[]
  
  @@index([eventId])
  @@index([venueId])
  @@index([isActive])
}

model Seat {
  id          String   @id @default(uuid())
  seatMapId   String
  seatMap     SeatMap  @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  
  // Seat identification
  seatIdentifier String // Unique identifier (e.g., "A1", "Section1-RowA-Seat1")
  sectionId      String? // Section ID from layout
  rowId          String? // Row ID from layout
  rowLabel       String? // Row label (e.g., "A", "1")
  seatLabel      String? // Seat label (e.g., "1", "2")
  
  // Seat properties
  seatType    SeatType @default(STANDARD)
  status      SeatStatus @default(AVAILABLE)
  
  // Pricing
  basePrice   Decimal? @db.Decimal(10, 2) // Base price for this seat
  currentPrice Decimal? @db.Decimal(10, 2) // Current price (may differ from base due to dynamic pricing)
  
  // Position (for visual rendering)
  x           Float?   // X coordinate on map
  y           Float?   // Y coordinate on map
  angle       Float?   // Rotation angle (for curved rows)
  
  // Metadata
  metadata    Json?    // Additional seat properties (aisle, restricted view, etc.)
  
  // Relations
  reservations SeatReservation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([seatMapId, seatIdentifier])
  @@index([seatMapId])
  @@index([status])
  @@index([seatType])
  @@index([sectionId, rowId])
}

model SeatReservation {
  id              String   @id @default(uuid())
  seatId          String
  seat            Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  registrationId  String   @unique
  registration    EventRegistration @relation("SeatReservation", fields: [registrationId], references: [id], onDelete: Cascade)
  
  // Reservation details
  reservedAt      DateTime @default(now())
  reservedUntil   DateTime? // For temporary reservations (cart timeout)
  confirmedAt     DateTime? // When reservation was confirmed (payment completed)
  
  // Pricing at time of reservation
  priceAtReservation Decimal @db.Decimal(10, 2)
  
  // Status
  status          String   @default("reserved") // "reserved", "confirmed", "cancelled"
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([seatId])
  @@index([registrationId])
  @@index([status])
  @@index([reservedUntil])
}

// Advanced Team Features
model TeamRoleTemplate {
  id          String   @id @default(uuid())
  organizerId String
  organizer   User     @relation("OrganizerRoleTemplates", fields: [organizerId], references: [id], onDelete: Cascade)
  
  name        String
  description String?  @db.Text
  
  // Permissions
  canEdit     Boolean  @default(false)
  canManageAttendees Boolean @default(false)
  canManageTickets Boolean @default(false)
  canViewAnalytics Boolean @default(true)
  canManageStaff Boolean @default(false)
  canPublish Boolean @default(false)
  canManageCollaborators Boolean @default(false)
  
  // Usage
  usageCount  Int      @default(0)
  
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([organizerId])
}

model TeamActivityFeed {
  id          String   @id @default(uuid())
  organizerId String
  organizer   User     @relation("OrganizerTeamActivities", fields: [organizerId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?   @relation("EventTeamActivities", fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserTeamActivities", fields: [userId], references: [id], onDelete: Cascade)
  
  action      String   // e.g., "event_created", "ticket_updated", "attendee_added"
  description String   @db.Text
  metadata    Json?
  
  createdAt DateTime @default(now())
  
  @@index([organizerId])
  @@index([eventId])
  @@index([userId])
  @@index([createdAt])
}

model TeamPerformanceMetric {
  id          String   @id @default(uuid())
  organizerId String
  organizer   User     @relation("OrganizerTeamMetrics", fields: [organizerId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("UserTeamMetrics", fields: [userId], references: [id], onDelete: Cascade)
  
  // Metrics
  eventsCreated     Int      @default(0)
  ticketsSold       Int      @default(0)
  revenueGenerated  Decimal  @default(0) @db.Decimal(10, 2)
  attendeesManaged  Int      @default(0)
  
  // Period
  periodStart DateTime
  periodEnd   DateTime
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([organizerId, userId, periodStart, periodEnd])
  @@index([organizerId])
  @@index([userId])
  @@index([periodStart])
}

// Admin Platform Financial Management
model PlatformExpense {
  id          String   @id @default(uuid())
  
  // Expense Details
  category    String   // e.g., "Teller Payments", "Marketing", "Facilitation", "Utilities", "Office Supplies", "Other"
  description String   @db.Text
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("NGN")
  
  // Payment Details
  paymentMethod String? // "cash", "bank_transfer", "credit_card", "check"
  recipient     String? // Who received the payment (e.g., teller name, vendor name)
  reference     String? // Payment reference number
  
  // Receipt/Proof
  receiptUrl  String?
  receiptDate DateTime?
  
  // Tax
  taxAmount   Decimal? @db.Decimal(10, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  isTaxDeductible Boolean @default(false)
  
  // Status
  status      String   @default("pending") // pending, approved, paid, cancelled
  
  // Recorded by
  recordedBy  String?  // Admin user ID who recorded this
  approvedBy  String?  // Admin user ID who approved this
  
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([category])
  @@index([expenseDate])
  @@index([status])
  @@index([createdAt])
}

model PlatformIncome {
  id          String   @id @default(uuid())
  
  // Income Details
  category    String   // e.g., "Platform Fees", "Subscriptions", "Event Registration Fees", "Other"
  description String   @db.Text
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("NGN")
  
  // Source Details
  source      String?  // Where the income came from (e.g., "EventKnit Platform", "Subscription Revenue")
  reference   String?  // Reference number (e.g., transaction ID, subscription ID)
  
  // Payment Details
  paymentMethod String? // "bank_transfer", "credit_card", "paystack", etc.
  
  // Related Entities (optional)
  eventId     String?  // If income is related to a specific event
  event       Event?   @relation("PlatformIncomeEvents", fields: [eventId], references: [id], onDelete: SetNull)
  transactionId String? // If related to a payment transaction
  
  // Tax
  taxAmount   Decimal? @db.Decimal(10, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  
  // Status
  status      String   @default("received") // received, pending, cancelled
  
  // Recorded by
  recordedBy  String?  // Admin user ID who recorded this
  
  incomeDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([category])
  @@index([incomeDate])
  @@index([status])
  @@index([createdAt])
  @@index([eventId])
}

// ============================================
// White-Label Solution Models
// ============================================

enum CustomDomainStatus {
  PENDING      // Domain added but not verified
  VERIFIED     // Domain verified and active
  FAILED       // Domain verification failed
  SUSPENDED    // Domain suspended by admin
}

enum BrandingStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL // For admin review
}

model WhiteLabelBranding {
  id                String         @id @default(uuid())
  organizerId       String         @unique
  organizer         User           @relation("OrganizerBranding", fields: [organizerId], references: [id], onDelete: Cascade)
  
  // Branding Assets
  logoUrl           String?        // Main logo URL
  logoLightUrl      String?        // Logo for light backgrounds
  logoDarkUrl       String?        // Logo for dark backgrounds
  faviconUrl        String?        // Favicon URL
  coverImageUrl     String?        // Cover/hero image
  
  // Color Scheme
  primaryColor      String?        // Primary brand color (hex)
  secondaryColor   String?        // Secondary brand color (hex)
  accentColor       String?        // Accent color (hex)
  backgroundColor   String?        // Background color (hex)
  textColor         String?        // Primary text color (hex)
  linkColor         String?        // Link color (hex)
  
  // Typography
  fontFamily        String?        // Primary font family
  headingFont       String?        // Heading font family
  
  // Branding Details
  brandName         String?        // Custom brand name (if different from organization name)
  tagline           String?        // Brand tagline/slogan
  supportEmail      String?        // Custom support email
  supportPhone      String?        // Custom support phone
  websiteUrl        String?        // Organization website
  
  // Email Branding
  emailHeaderImage  String?        // Image for email headers
  emailFooterText   String?        // Custom footer text for emails
  emailSignature    String?        @db.Text // Email signature HTML
  
  // Social Media
  socialLinks       Json?          // {facebook, twitter, instagram, linkedin, etc.}
  
  // Status
  status            BrandingStatus @default(PENDING_APPROVAL)
  isActive          Boolean        @default(false)
  approvedBy        String?        // Admin user ID who approved
  approvedAt        DateTime?
  rejectionReason   String?        @db.Text
  
  // Metadata
  metadata          Json?          // Additional branding settings
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  @@index([organizerId])
  @@index([status])
  @@index([isActive])
}

model CustomDomain {
  id                String             @id @default(uuid())
  organizerId       String
  organizer         User               @relation("OrganizerCustomDomains", fields: [organizerId], references: [id], onDelete: Cascade)
  
  // Domain Details
  domain            String             @unique // e.g., events.example.com
  subdomain         String?            // If using subdomain approach
  isPrimary         Boolean            @default(false) // Primary domain for the organizer
  
  // DNS Verification
  status            CustomDomainStatus @default(PENDING)
  verificationToken String?            // Token for DNS verification
  verificationCode  String?            // Code to add to DNS TXT record
  verifiedAt        DateTime?
  verifiedBy        String?            // Admin user ID who verified
  
  // SSL Certificate
  sslEnabled        Boolean            @default(false)
  sslCertificate    String?            @db.Text // SSL certificate (if self-hosted)
  sslKey            String?            @db.Text // SSL private key (if self-hosted)
  sslExpiresAt      DateTime?
  
  // Configuration
  cnameTarget       String?            // CNAME target for DNS setup
  ipAddress         String?            // IP address for A record setup
  
  // Status
  isActive          Boolean            @default(false)
  lastCheckedAt     DateTime?          // Last DNS verification check
  failureReason     String?            @db.Text
  
  // Metadata
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  @@index([organizerId])
  @@index([domain])
  @@index([status])
  @@index([isActive])
  @@index([isPrimary])
}

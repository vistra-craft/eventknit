  secondaryColor  String? // Secondary brand color (hex)
  accentColor     String? // Accent color (hex)
  backgroundColor String? // Background color (hex)
  textColor       String? // Primary text color (hex)
  linkColor       String? // Link color (hex)

  // Typography
  fontFamily  String? // Primary font family
  headingFont String? // Heading font family

  // Branding Details
  brandName    String? // Custom brand name (if different from organization name)
  tagline      String? // Brand tagline/slogan
  supportEmail String? // Custom support email
  supportPhone String? // Custom support phone
  websiteUrl   String? // Organization website

  // Email Branding
  emailHeaderImage String? // Image for email headers
  emailFooterText  String? // Custom footer text for emails
  emailSignature   String? @db.Text // Email signature HTML

  // Social Media
  socialLinks Json? // {facebook, twitter, instagram, linkedin, etc.}

  // Status
  status          BrandingStatus @default(PENDING_APPROVAL)
  isActive        Boolean        @default(false)
  approvedBy      String? // Admin user ID who approved
  approvedAt      DateTime?
  rejectionReason String?        @db.Text

  // Metadata
  metadata  Json? // Additional branding settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([status])
  @@index([isActive])
}

model CustomDomain {
  id          String @id @default(uuid())
  organizerId String
  organizer   User   @relation("OrganizerCustomDomains", fields: [organizerId], references: [id], onDelete: Cascade)

  // Domain Details
  domain    String  @unique // e.g., events.example.com
  subdomain String? // If using subdomain approach
  isPrimary Boolean @default(false) // Primary domain for the organizer

  // DNS Verification
  status            CustomDomainStatus @default(PENDING)
  verificationToken String? // Token for DNS verification
  verificationCode  String? // Code to add to DNS TXT record
  verifiedAt        DateTime?
  verifiedBy        String? // Admin user ID who verified

  // SSL Certificate
  sslEnabled     Boolean   @default(false)
  sslCertificate String?   @db.Text // SSL certificate (if self-hosted)
  sslKey         String?   @db.Text // SSL private key (if self-hosted)
  sslExpiresAt   DateTime?

  // Configuration
  cnameTarget String? // CNAME target for DNS setup
  ipAddress   String? // IP address for A record setup

  // Status
  isActive      Boolean   @default(false)
  lastCheckedAt DateTime? // Last DNS verification check
  failureReason String?   @db.Text

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([domain])
  @@index([status])
  @@index([isActive])
  @@index([isPrimary])
}

// ============================================================================
// FINANCIAL ACCOUNTING MODELS
// ============================================================================

enum FinancialEntryStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethodType {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
  MOBILE_MONEY
  MPESA
  OTHER
}

// Wage payments to employees/contractors
model Wage {
  id            String               @id @default(cuid())
  employeeId    String?
  employeeName  String
  department    String?
  position      String?
  amount        Decimal              @db.Decimal(10, 2)
  currency      String               @default("KES")
  payPeriod     String // e.g., "January 2025", "Q1 2025"
  payDate       DateTime
  status        FinancialEntryStatus @default(PENDING)
  paymentMethod PaymentMethodType    @default(BANK_TRANSFER)
  reference     String? // Payment reference/transaction ID
  notes         String?              @db.Text

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([payDate])
  @@index([status])
  @@index([department])
}

// Income entries (revenue sources)
model Income {
  id            String               @id @default(cuid())
  category      String // e.g., "Ticket Sales", "Sponsorship", "Merchandise"
  description   String
  source        String? // Who/where the income came from
  amount        Decimal              @db.Decimal(10, 2)
  currency      String               @default("KES")
  date          DateTime
  status        FinancialEntryStatus @default(COMPLETED)
  paymentMethod PaymentMethodType?
  reference     String? // Invoice/receipt number
  notes         String?              @db.Text

  // Optional event association
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([status])
  @@index([eventId])
}

// Expense entries (costs/outflows)
model Expense {
  id            String               @id @default(cuid())
  category      String // e.g., "Marketing", "Utilities", "Equipment", "Venue"
  description   String
  recipient     String? // Who was paid
  amount        Decimal              @db.Decimal(10, 2)
  currency      String               @default("KES")
  date          DateTime
  status        FinancialEntryStatus @default(COMPLETED)
  paymentMethod PaymentMethodType?
  reference     String? // Invoice/receipt number
  notes         String?              @db.Text

  // Optional event association
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([status])
  @@index([eventId])
}

// Badge templates for printing attendee badges
model BadgeTemplate {
  id              String  @id @default(cuid())
  name            String
  description     String? @db.Text
  width           Float   @default(101.6) // mm (4 inches)
  height          Float   @default(76.2) // mm (3 inches)
  sizePreset      String  @default("4x3") // 4x3, 3.5x2.25, 4x6, A6, custom
  orientation     String  @default("landscape") // landscape, portrait
  backgroundColor String  @default("#ffffff")
  backgroundImage String? // Cloudinary URL for background image
  elements        Json // Array of BadgeElement objects
  isDefault       Boolean @default(false)
  isActive        Boolean @default(true)

  // Ownership - can be platform-wide (null) or organizer-specific
  organizerId String?
  organizer   OrganizerProfile? @relation(fields: [organizerId], references: [id], onDelete: SetNull)

  // Optional event-specific template
  eventId String?
  event   Event?  @relation("EventBadgeTemplates", fields: [eventId], references: [id], onDelete: SetNull)

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  printJobs PrintJob[]

  @@index([organizerId])
  @@index([eventId])
  @@index([isDefault])
  @@index([isActive])
}

// Print job history for badges
model BadgePrintJob {
  id             String            @id @default(cuid())
  eventId        String
  event          Event             @relation("EventBadgePrintJobs", fields: [eventId], references: [id], onDelete: Cascade)
  templateId     String
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  status         String            @default("pending") // pending, printing, completed, failed
  error          String?           @db.Text
  printedAt      DateTime?
  printedBy      String?
  printerInfo    Json? // Device info
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([eventId])
  @@index([registrationId])
  @@index([status])
  @@index([printedAt])
}

// Attendee bulk import history for MICE events
model AttendeeImport {
  id                String    @id @default(uuid())
  eventId           String
  event             Event     @relation("EventAttendeeImports", fields: [eventId], references: [id], onDelete: Cascade)
  importedBy        String // User ID who initiated the import
  fileName          String // Original file name
  totalRows         Int // Total rows in file (excluding header)
  successCount      Int       @default(0)
  errorCount        Int       @default(0)
  status            String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  sendWelcomeEmails Boolean   @default(false)
  errors            Json? // Array of { row, field, message } error details
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// Facility Access Control Models (Phase 2)
// ============================================

// Facility Zone - Group facilities into access zones
model FacilityZone {
  id               String    @id @default(cuid())
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String // e.g., "VIP Lounge", "Speaker Area"
  code             String // Short code (e.g., "VIP", "SPK")
  description      String?   @db.Text
  maxCapacity      Int? // Maximum simultaneous occupancy (null = unlimited)
  currentOccupancy Int       @default(0)
  accessStart      DateTime? // Zone operating hours start
  accessEnd        DateTime? // Zone operating hours end
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  facilities     FacilityZoneMapping[]
  attendeeAccess AttendeeZoneAccess[]
  movementsFrom  FacilityMovement[]    @relation("MovementFrom")
  movementsTo    FacilityMovement[]    @relation("MovementTo")

  @@unique([eventId, code])
  @@index([eventId, isActive])
}

// Mapping between facilities and zones
model FacilityZoneMapping {
  id         String        @id @default(cuid())
  facilityId String
  facility   EventFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  zoneId     String
  zone       FacilityZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([facilityId, zoneId])
  @@index([facilityId])
  @@index([zoneId])
}

// Attendee access permissions to zones
model AttendeeZoneAccess {
  id             String            @id @default(cuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  zoneId         String
  zone           FacilityZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  grantedAt      DateTime          @default(now())
  grantedBy      String // User ID who granted access
  expiresAt      DateTime? // Access expiration (null = no expiration)
  isActive       Boolean           @default(true)
  accessCount    Int               @default(0) // Number of times accessed
  lastAccessAt   DateTime? // Last access timestamp
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([registrationId, zoneId])
  @@index([registrationId])
  @@index([zoneId, isActive])
}

// Track attendee movement between zones
model FacilityMovement {
  id             String            @id @default(cuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromZoneId     String?
  fromZone       FacilityZone?     @relation("MovementFrom", fields: [fromZoneId], references: [id], onDelete: SetNull)
  toZoneId       String
  toZone         FacilityZone      @relation("MovementTo", fields: [toZoneId], references: [id], onDelete: Cascade)
  movementType   String // "entry", "zone_change", "exit"
  sequenceNumber Int // Track visit order (1, 2, 3...)
  scannedAt      DateTime          @default(now())
  scannedBy      String // User ID who performed scan
  deviceInfo     Json? // Device/scanner information

  @@index([registrationId, scannedAt])
  @@index([eventId, scannedAt])
  @@index([fromZoneId])
  @@index([toZoneId])
}

// ==================== Printer Integration Models ====================

// Printer device configuration
model Printer {
  id             String    @id @default(cuid())
  eventId        String?
  event          Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  name           String // User-friendly name
  driver         String // "cups", "windows", "printnode"
  deviceId       String // System printer name or cloud ID
  host           String? // For network printers (e.g., "192.168.1.100")
  port           Int? // For network printers (e.g., 9100)
  apiKey         String? // For PrintNode cloud printing
  supportedSizes String[] // ["4x3", "A6", "Letter"] JSON array
  paperSize      String? // Default paper size
  orientation    String? // "portrait" or "landscape"
  isOnline       Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastChecked    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String // User ID who added printer

  printJobs PrintJob[]

  @@index([eventId, isActive])
  @@index([driver, isOnline])
}

// Print job queue with retry logic
model PrintJob {
  id             String            @id @default(cuid())
  printerId      String
  printer        Printer           @relation(fields: [printerId], references: [id], onDelete: Cascade)
  templateId     String
  template       BadgeTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  status         String            @default("queued") // "queued", "printing", "completed", "failed", "cancelled"
  priority       Int               @default(0) // Higher = print sooner
  copies         Int               @default(1)
  pdfUrl         String? // Generated PDF URL (Cloudinary)
  sentToPrinter  DateTime?
  printedAt      DateTime?
  retryCount     Int               @default(0)
  maxRetries     Int               @default(3)
  errorMessage   String?
  jobMetadata    Json? // Additional job data (printer settings, etc.)
  createdBy      String // User ID who created print job
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([printerId, status])
  @@index([status, priority, createdAt])
  @@index([registrationId])
  @@index([templateId])
  @@index([createdAt])
}

// ============================================================================
// CART RESERVATION SYSTEM
// ============================================================================
// Temporary cart system for holding tickets before payment completion
// Carts expire after a configurable timeout (default 8 minutes)

enum CartStatus {
  ACTIVE // Cart is active and items can be modified
  RESERVED // Cart has been reserved for payment (in payment flow)
  COMPLETED // Cart has been converted to registration
  EXPIRED // Cart expired due to timeout
  ABANDONED // Cart was abandoned by user
}

model CartReservation {
  id     String  @id @default(uuid())
  userId String? // Null for guest carts (identified by sessionId)
  user   User?   @relation("UserCarts", fields: [userId], references: [id], onDelete: Cascade)

  // Session tracking for guests
  sessionId   String  @unique // Anonymous session ID for guest carts
  fingerprint String? // Device fingerprint for fraud detection

  // Cart status and timing
  status    CartStatus @default(ACTIVE)
  expiresAt DateTime // When cart reservation expires

  // Reserved tickets are held until expiration
  reservedAt  DateTime? // When cart was moved to RESERVED status
  completedAt DateTime? // When cart was converted to registration

  // IP and device info for fraud prevention
  ipAddress String?
  userAgent String? @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

model CartItem {
  id     String          @id @default(uuid())
  cartId String
  cart   CartReservation @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Event and ticket details
  eventId    String
  event      Event   @relation("CartEvents", fields: [eventId], references: [id], onDelete: Cascade)
  ticketType String // Ticket type name/ID
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)

  // Seat selection (if applicable)
  seatIds String[] // Array of reserved seat IDs

  // Promo code (applied at item level)
  promoCodeId    String?
  discountAmount Decimal? @db.Decimal(10, 2)

  // Lock tracking
  inventoryLocked Boolean @default(false) // Whether inventory has been decremented

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([eventId])
  @@index([ticketType])
}

// Career Inquiries - Candidates interested in joining EventKnit
model CareerInquiry {
  id        String  @id @default(uuid())
  email     String
  firstName String? // Extracted from email response (optional)

  // Status tracking
  status      String    @default("PENDING") // PENDING, CONTACTED, RESPONDED, REVIEWING, REJECTED, HIRED
  emailSentAt DateTime  @default(now()) // When the auto-reply was sent
  respondedAt DateTime? // When they replied

  // Notes from recruitment team
  notes      String?   @db.Text
  reviewedBy String? // User ID of recruiter who reviewed
  reviewedAt DateTime?

  // Metadata
  source    String? // Where they found us (optional tracking)
  ipAddress String? // For spam prevention
  userAgent String? // Browser info

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

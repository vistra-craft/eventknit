generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  ADMIN_STAFF
  MARKETER
  SUPPORT
  TELLER
  ORGANIZER
  ORGANIZER_STAFF
  ORGANIZER_TELLER
  ATTENDEE
}

enum UserStatus {
  ACTIVE // User account is active and can use the platform fully
  SUSPENDED // Admin action: User is banned (punitive) - cannot login or use platform
  DEACTIVATED // User self-deactivated or admin soft-deleted (non-punitive) - can login but cannot perform actions, can be reactivated
  PENDING_APPROVAL // Organizer registered but awaiting admin approval - can login with limited access
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizerEntityType {
  INDIVIDUAL
  SOLE_PROPRIETOR
  PARTNERSHIP
  LIMITED_LIABILITY_COMPANY
  LIMITED_LIABILITY_PARTNERSHIP
  EMPLOYMENT_AGENCY_LLC
  FOREIGN_COMPANY_COMPLIANCE
  PRIVATE_HOSPITAL_SOLE_PROPRIETOR
  PRIVATE_HOSPITAL_LLC
  PUBLIC_HOSPITAL
  PRIVATE_EDUCATION_SOLE_PROPRIETOR
  PRIVATE_EDUCATION_LLC
  INTERNATIONAL_EDUCATION_LLC
  PUBLIC_EDUCATION
  COOPERATIVE_SOCIETY
  INSURANCE_REINSURANCE
  NGO
  EMBASSY_UN_WORLD_BANK
  DENOMINATIONAL_CHURCH
  PARTNERSHIP_PROFESSIONAL
  TRUST
}

enum KYCDocumentType {
  // Common documents
  PP_NEW_CONTRACT
  NATIONAL_ID
  PASSPORT
  ALIEN_ID
  MILITARY_ID
  KRA_PIN
  CERTIFICATE_OF_REGISTRATION
  CERTIFICATE_OF_INCORPORATION
  COMPANY_KRA_PIN
  BANK_STATEMENT
  CANCELLED_CHEQUE
  BANK_LETTER
  LETTER_AUTHORIZING_ENTRY
  BUSINESS_LICENSE
  TAX_ID

  // Company-specific
  CR12
  CR13
  PARTNERSHIP_DEED
  AFFIDAVIT

  // Industry-specific
  MINISTRY_OF_HEALTH_LICENSE
  KMPDB_LICENSE
  MINISTRY_OF_EDUCATION_LICENSE
  EPRA_LICENSE
  IRA_LICENSE
  TRA_MEMBERSHIP
  KATO_MEMBERSHIP
  KATA_MEMBERSHIP
  KCAA_REGISTRATION
  TOUR_OPERATOR_LICENSE

  // Organization-specific
  ORGANIZATION_CONSTITUTION
  BOARD_ELECTION_MINUTES
  TRUST_DEED
  ACCREDITATION_LETTER
  AGREEMENT_LETTER
  LETTER_OF_INTRODUCTION
  COUNTY_CONTRACT_FORM

  // Special documents
  COMPANY_PROFILE
  ONLINE_LINK
  TRADE_NAME_CERTIFICATE
  GRANT_PROBATE
  AUTHORIZED_SIGNATORY_LETTER

  // Till-specific (separate from basic KYC)
  TILL_APPLICATION_FORM
  MPESA_AUTHORIZATION_FORM
  ANNUAL_RETURNS
  DIRECTORS_LIST_LETTERHEAD
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum EventStatus {
  PENDING // Waiting for admin approval
  APPROVED // Approved by admin, visible to public
  REJECTED // Rejected by admin
  CANCELLED // Cancelled by organizer
  COMPLETED // Event has ended
}

enum EventType {
  PUBLIC // Public event, visible to all
  PRIVATE // Private event, invite-only
}

enum RegistrationStatus {
  PENDING // Registration pending (no payment yet)
  CONFIRMED // Registration confirmed (payment completed or free event)
  CANCELLED // Registration cancelled
}

enum InviteType {
  ATTENDEE // General attendee registration
  SPEAKER // Speaker registration/invitation
  EXHIBITOR // Exhibitor registration/invitation
  GUEST // Guest/VIP invitation
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoCodeScope {
  PLATFORM // Works on any event (admin only)
  ORGANIZER // Works on all events by the organizer
  EVENT // Works on a single event
  MULTI_EVENT // Works on selected multiple events
}

enum PromoCodeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DataAccessLevel {
  RESTRICTED // Summary cards only (total attendees, total revenue)
  STANDARD // Attendee list + payment summaries (no transaction IDs)
  FULL // Everything except transaction IDs (detailed payment info)
}

enum SubscriptionTier {
  BASIC // Free tier - aggregated data only
  STANDARD // Free tier - basic attendee data with consent
  PREMIUM // Paid tier - advanced analytics and demographics
}

enum TicketStatus {
  ACTIVE // Ticket is active and can be used
  DEACTIVATED // Ticket has been scanned/checked in
  EXPIRED // Ticket has expired
  CANCELLED // Ticket has been cancelled
}

enum ScanType {
  CHECK_IN // Standard check-in scan
  CHECK_OUT // Standard check-out scan
  MANUAL_CHECK_IN // Manual check-in by staff
  MANUAL_CHECK_OUT // Manual check-out by staff
}

model User {
  id                 String  @id @default(uuid())
  email              String  @unique
  password           String? // Optional - users can set password later in profile
  firstName          String? // Optional - can be added in profile
  lastName           String? // Optional - can be added in profile
  otherName          String? // Middle name or other names
  phoneNumber        String?
  companyAffiliation String? // Company or institutional affiliation

  // OAuth provider IDs
  googleId        String?    @unique // Google OAuth user ID
  appleId         String?    @unique // Apple Sign In user ID
  // Contact address information
  address         String?
  city            String?
  state           String?
  country         String?
  zipCode         String?
  role            UserRole   @default(ATTENDEE)
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)
  emailVerifiedAt DateTime?

  // Organizer-specific fields (optional - can be added later)
  organizationName String?
  businessEmail    String?
  avatar           String? // Profile picture URL

  // Organization relationship (Option A: managedBy field)
  managedBy     String? // User ID of organizer/admin who manages this user
  managedByUser User?   @relation("ManagedUsers", fields: [managedBy], references: [id], onDelete: SetNull)
  managedUsers  User[]  @relation("ManagedUsers")

  // KYC fields (for organizers)
  kycStatus                   KYCStatus?
  kycSubmittedAt              DateTime?
  kycApprovedAt               DateTime?
  organizerEntityType         OrganizerEntityType?
  organizerIndustry           String? // Industry/business type (for conditional requirements)
  organizerBusinessName       String? // Trade name (if different from registration name)
  organizerCountry            String?              @default("KE") // Default to Kenya, expandable for multi-country
  organizerRegistrationNumber String? // Business registration/incorporation number

  // Verification levels (progressive verification system)
  isIdentityVerified Boolean   @default(false) // Level 2: Identity verified (can create paid events with limits)
  identityVerifiedAt DateTime?
  payoutLimit        Decimal?  @db.Decimal(10, 2) // Monthly payout limit (null = unlimited, requires full KYC)
  verificationLevel  Int       @default(1) // 1=Basic, 2=Identity Verified, 3=Full KYC

  // Security fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  // Two-Factor Authentication (2FA)
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String? // TOTP secret (encrypted)
  twoFactorBackupCodes String[] // Backup codes for 2FA recovery
  twoFactorVerifiedAt  DateTime? // When 2FA was verified/set up

  // Onboarding fields (for organizers)
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  profileCompleted      Boolean   @default(false)
  profileCompletedAt    DateTime?
  eventPreferences      Json? // Store event types, organization type, events per year, etc.

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  // Relations
  refreshTokens                     RefreshToken[]
  emailVerifications                EmailVerification[]
  passwordResets                    PasswordReset[]
  magicLinkTokens                   MagicLinkToken[]
  pendingEmailChanges               PendingEmailChange[]
  kycDocuments                      KYCDocument[]
  organizerDirectors                OrganizerDirector[]          @relation("OrganizerDirectors")
  attendeeConsents                  AttendeeConsent[]            @relation("AttendeeConsents")
  organizerSubscription             OrganizerSubscription?       @relation("OrganizerSubscriptions")
  dataAccessAuditLogs               DataAccessAuditLog[]         @relation("DataAccessAuditLogs")
  auditLogs                         AuditLog[]
  eventsCreated                     Event[]                      @relation("EventOrganizer")
  eventRegistrations                EventRegistration[]
  invitationsCreated                EventInvitation[]            @relation("InvitationCreator")
  templatesCreated                  TicketTemplate[]             @relation("TemplateCreator")
  featuredEventsCreated             FeaturedEvent[]              @relation("FeaturedEventCreator")
  promoCodesCreated                 PromoCode[]                  @relation("PromoCodeOrganizer")
  referralCodes                     PromoCode[]                  @relation("PromoCodeReferrer")
  promoCodeRedemptions              PromoCodeRedemption[]        @relation("PromoCodeUser")
  promoCodeRequests                 PromoCodeRequest[]           @relation("PromoCodeRequestOrganizer")
  promoCodeRequestsReviewed         PromoCodeRequest[]           @relation("PromoCodeRequestReviewer")
  eventAssignments                  EventStaff[]                 @relation("EventStaff")
  checkpointStaffAssignments        CheckpointStaff[]            @relation("CheckpointStaffAssignment")
  // Event Payment Relations
  organizerDisbursements            OrganizerDisbursement[]      @relation("OrganizerDisbursements")
  disbursementsCreated              OrganizerDisbursement[]      @relation("DisbursementCreator")
  refundsRequested                  Refund[]                     @relation("RefundRequester")
  refundsProcessed                  Refund[]                     @relation("RefundProcessor")
  reconciliationsCreated            PaymentReconciliation[]      @relation("PaymentReconciler")
  // Notification Relations
  notifications                     Notification[]               @relation("UserNotifications")
  notificationPreference            NotificationPreference?      @relation("UserNotificationPreference")
  pushSubscriptions                 PushSubscription[]           @relation("UserPushSubscriptions")
  mobileDevices                     MobileDevice[]               @relation("UserMobileDevices")
  systemNotificationSettingsUpdated SystemNotificationSettings[] @relation("SystemNotificationSettingsUpdatedBy")
  bulkMessagesCreated               BulkMessage[]                @relation("BulkMessageCreator")
  preferences                       UserPreferences?             @relation("UserPreferences")
  emailTemplatesCreated             EmailTemplate[]              @relation("EmailTemplateCreator")
  // Social Media & Support Relations
  assignedSupportQueries            SocialMessage[]              @relation("AssignedSupportQueries")
  supportResponses                  SupportResponse[]            @relation("SupportResponses")
  // User Dashboard Features Relations
  eventReviews                      EventReview[]                @relation("UserReviews")
  eventFeedback                     EventFeedback[]              @relation("UserFeedback")
  ticketTransfersFrom               TicketTransfer[]             @relation("TicketTransfersFrom")
  ticketTransfersTo                 TicketTransfer[]             @relation("TicketTransfersTo")
  eventCollections                  EventCollection[]            @relation("UserCollections")
  collectionFollows                 CollectionFollower[]         @relation("CollectionFollows")
  userInterests                     UserInterest[]               @relation("UserInterests")
  sentMessages                      DirectMessage[]              @relation("SentMessages")
  ticketResales                     TicketResale[]               @relation("TicketResales")
  ticketResalePurchases             TicketResale[]               @relation("TicketResalePurchases")
  digitalWallet                     DigitalWallet?               @relation("UserDigitalWallet")
  calendarSyncs                     EventCalendarSync[]          @relation("UserCalendarSyncs")
  eventFeed                         PersonalEventFeed?           @relation("UserEventFeed")
  eventSubscriptions                EventUpdateSubscription[]    @relation("UserEventSubscriptions")
  receivedMessages                  DirectMessage[]              @relation("ReceivedMessages")
  userFollowers                     UserFollow[]                 @relation("UserFollowers")
  userFollowing                     UserFollow[]                 @relation("UserFollowing")
  eventShares                       EventShare[]                 @relation("UserShares")
  savedSearches                     SavedSearch[]                @relation("SavedSearches")
  savedEvents                       SavedEvent[]                 @relation("UserSavedEvents")
  activityHistory                   ActivityHistory[]            @relation("UserActivityHistory")
  ussdSessions                      USSDSession[]
  servicePointSessions              ServicePointSession[]        @relation("ServicePointStaff")
  // Organizer Dashboard Features
  eventTemplates                    EventTemplate[]              @relation("OrganizerTemplates")
  eventDrafts                       EventDraft[]                 @relation("OrganizerDrafts")
  attendeeSegments                  AttendeeSegment[]            @relation("OrganizerSegments")
  segmentMembers                    AttendeeSegmentMember[]      @relation("SegmentMembers")
  attendeeTags                      AttendeeTag[]                @relation("OrganizerTags")
  taggedUsers                       AttendeeTaggedUser[]         @relation("TaggedUsers")
  // Phase 2 Features
  eventExpenses                     EventExpense[]               @relation("OrganizerExpenses")
  financialGoals                    FinancialGoal[]              @relation("OrganizerFinancialGoals")
  payoutPreference                  PayoutPreference?            @relation("OrganizerPayoutPreferences")
  eventCollaborations               EventCollaborator[]          @relation("UserEventCollaborations")
  eventActivityLogs                 EventActivityLog[]           @relation("UserEventActivityLogs")
  // Phase 3 Features
  ticketPackages                    TicketPackage[]              @relation("OrganizerTicketPackages")
  pricingRules                      DynamicPricingRule[]         @relation("OrganizerPricingRules")
  affiliatePrograms                 AffiliateProgram[]           @relation("OrganizerAffiliatePrograms")
  emailCampaigns                    EmailCampaign[]              @relation("OrganizerEmailCampaigns")
  emailAutomations                  EmailAutomationRule[]        @relation("OrganizerEmailAutomations")
  socialPosts                       SocialMediaPost[]            @relation("OrganizerSocialPosts")
  socialCalendars                   SocialMediaCalendar[]        @relation("OrganizerSocialCalendars")
  postTemplates                     SocialMediaPostTemplate[]    @relation("OrganizerPostTemplates")
  roleTemplates                     TeamRoleTemplate[]           @relation("OrganizerRoleTemplates")
  customRole                        TeamRoleTemplate?            @relation("StaffCustomRole", fields: [customRoleId], references: [id], onDelete: SetNull)
  customRoleId                      String?
  teamActivities                    TeamActivityFeed[]           @relation("OrganizerTeamActivities")
  userTeamActivities                TeamActivityFeed[]           @relation("UserTeamActivities")
  teamMetrics                       TeamPerformanceMetric[]      @relation("OrganizerTeamMetrics")
  userTeamMetrics                   TeamPerformanceMetric[]      @relation("UserTeamMetrics")
  affiliates                        Affiliate[]                  @relation("UserAffiliates")
  // White-Label Branding
  whiteLabelBranding                WhiteLabelBranding?          @relation("OrganizerBranding")
  customDomains                     CustomDomain[]               @relation("OrganizerCustomDomains")
  // Seating & Venues
  venues                            Venue[]                      @relation("OrganizerVenues")

  // Extended Profile Relations
  staffProfile     StaffProfile?     @relation("UserStaffProfile")
  organizerProfile OrganizerProfile? @relation("UserOrganizerProfile")
  emergencyContact EmergencyContact? @relation("UserEmergencyContact")

  // GDPR Data Export
  dataExportRequests DataExportRequest[] @relation("DataExportRequests")

  // Cart Reservation System
  carts CartReservation[] @relation("UserCarts")

  // Credit/Voucher System
  userCredit         UserCredit?         @relation("UserCredits")
  creditTransactions CreditTransaction[] @relation("CreditInitiator")
  vouchersCreated    Voucher[]           @relation("VoucherCreator")
  organizerVouchers  Voucher[]           @relation("OrganizerVouchers")
  voucherRedemptions VoucherRedemption[] @relation("VoucherRedemptions")
  emailDigestQueue   EmailDigestQueue[]  @relation("UserDigestQueue")
  eventReports       EventReport[]       @relation("EventReports")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([managedBy])
  @@index([organizationName])
}

// Extended Profile Models for Admin Management

enum StaffDepartment {
  OPERATIONS
  CUSTOMER_SERVICE
  TECHNICAL
  MANAGEMENT
  FINANCE
  MARKETING
}

model StaffProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserStaffProfile", fields: [userId], references: [id], onDelete: Cascade)

  // Employment Info
  employeeId String?         @unique
  department StaffDepartment @default(OPERATIONS)
  location   String?
  hireDate   DateTime        @default(now())

  // Compensation
  salary     Decimal? @db.Decimal(12, 2)
  hourlyRate Decimal? @db.Decimal(8, 2)

  // Permissions (JSON object for flexibility)
  permissions Json? @default("{}")

  // Performance tracking
  totalHours Decimal? @default(0) @db.Decimal(10, 2)
  rating     Decimal? @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([employeeId])
}

model OrganizerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserOrganizerProfile", fields: [userId], references: [id], onDelete: Cascade)

  // Business Info
  website          String?
  description      String? @db.Text
  socialLinks      Json?   // {facebook, twitter, instagram, linkedin, youtube, tiktok}
  businessLicense  String?
  taxId            String?
  bankAccountLast4 String? // Store only last 4 digits for display

  // Location
  location String?

  // Statistics (can be computed or cached)
  totalEvents  Int      @default(0)
  totalRevenue Decimal? @default(0) @db.Decimal(14, 2)
  rating       Decimal? @db.Decimal(3, 2)

  // Badge/Workstation Relations
  badgeTemplates BadgeTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model EmergencyContact {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserEmergencyContact", fields: [userId], references: [id], onDelete: Cascade)

  name         String
  phone        String
  relationship String
  email        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id            String    @id @default(uuid())
  token         String    @unique
  userId        String
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revoked       Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String?
  email      String // Store email for code-based verification before user creation
  code       String? // 6-digit verification code
  token      String?   @unique // Token for link-based verification (backward compatibility)
  role       UserRole? // Store selected role during registration
  expiresAt  DateTime
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([email])
  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@index([used])
}

model PendingEmailChange {
  id        String    @id @default(uuid())
  userId    String
  oldEmail  String
  newEmail  String
  code      String // 6-digit verification code (sent to new email)
  expiresAt DateTime
  verified  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
  @@index([expiresAt])
}

model KYCDocument {
  id               String          @id @default(uuid())
  userId           String
  documentType     KYCDocumentType
  documentNumber   String?
  documentUrl      String?
  documentCategory String? // For grouping (e.g., "identity", "registration", "financial")
  status           KYCStatus       @default(PENDING)
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?

  // Document metadata
  issueDate     DateTime? // When document was issued
  expiryDate    DateTime? // When document expires
  isRequired    Boolean   @default(true) // Whether this document is required
  isConditional Boolean   @default(false) // Whether this is a conditional requirement

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([documentType])
  @@index([userId, documentType]) // For checking if user has specific document type
}

model OrganizerDirector {
  id              String   @id @default(uuid())
  userId          String // Organizer user ID
  fullName        String
  nationality     String
  dateOfBirth     DateTime
  documentType    String // NATIONAL_ID, PASSPORT, ALIEN_ID, MILITARY_ID
  documentNumber  String
  kraPin          String?
  sharePercentage Decimal? @db.Decimal(5, 2) // Percentage of shares (null for directors without shares)
  isTopFive       Boolean  @default(true) // Whether this is in the top 5 by share percentage
  position        String? // Director, Shareholder, Trustee, Partner, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("OrganizerDirectors", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isTopFive])
}

model EntityRequirement {
  id                 String                @id @default(uuid())
  entityType         OrganizerEntityType
  documentType       String // e.g., "PP_NEW_CONTRACT", "NATIONAL_ID", etc.
  description        String? // Human-readable description (e.g., "Valid national ID card")
  isRequired         Boolean               @default(true) // Required vs optional
  displayOrder       Int                   @default(0) // For UI ordering
  validityPeriodDays Int? // Document validity period in days

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, documentType]) // Each entity type can only have one requirement per document type
  @@index([entityType])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String? // User, Event, etc.
  entityId    String?
  metadata    Json? // Additional data
  ipAddress   String?
  userAgent   String?
  country     String? // Country name
  countryCode String? // ISO country code (e.g., "KE", "US")
  region      String? // Region/state
  city        String? // City name
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@index([countryCode])
  @@index([ipAddress])
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String   @db.Text
  fullDescription String?  @db.Text
  category        String?
  tags            String[] // Array of tags

  // Dates and times
  startDate            DateTime
  endDate              DateTime?
  startTime            String? // Time string (e.g., "09:00 AM")
  endTime              String? // Time string (e.g., "05:00 PM")
  registrationDeadline DateTime?

  // Location
  venue       String?
  venueName   String? // For backward compatibility/specific UI needs
  location    String // City, State or full address
  address     String? // Full street address
  isOnline    Boolean @default(false)
  onlineLink  String?
  coordinates Json? // { lat: number, lng: number }

  // Pricing
  isFree      Boolean  @default(false)
  price       Decimal? @db.Decimal(10, 2) // Single price for simple events
  basePrice   Decimal? @db.Decimal(10, 2) // For backward compatibility
  currency    String   @default("USD") // Currency code (e.g., "USD", "KES", "NGN")
  ticketTypes Json? // Array of ticket types with prices
  timezone    String? // Event timezone

  // Capacity
  capacity          Int? // Total capacity (null = unlimited)
  availableSlots    Int? // Calculated available slots
  maxTicketsPerUser Int  @default(10) // Maximum tickets a single user can purchase (anti-scalping)

  // Venue Capacity (for facility access control)
  venueMaxCapacity      Int? // Maximum venue occupancy (null = unlimited)
  venueCurrentOccupancy Int  @default(0) // Current number of people in venue

  // Media
  image       String? // Image URL
  imageFocalX Int?     @default(50) // Focal point X position (0-100)
  imageFocalY Int?     @default(50) // Focal point Y position (0-100)
  coverImage  String? // For backward compatibility
  bannerImage String? // For banner/header use
  images      String[] // Array of image URLs

  // Event details
  type           EventType   @default(PUBLIC)
  eventType      String?     @default("PUBLIC") // For backward compatibility/specific UI needs
  status         EventStatus @default(PENDING)
  requirements   String[] // Array of requirements
  ageRestriction String? // e.g., "18+", "All Ages"
  duration       String? // e.g., "8 hours", "3 days"

  // Additional content
  speakers             Json? // Array of speakers
  sponsors             Json? // Array of sponsors
  exhibitors           Json? // Array of exhibitors
  agenda               Json? // Array of agenda items/schedule
  socialLinks          Json? // Object containing social media links
  faqs                 Json? // Array of FAQs
  registrationFields   Json? // Custom registration form fields
  organizerDescription String? @db.Text // Organizer's description about themselves/their organization

  // Organizer
  organizerId String
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  // Admin approval
  approvedBy      String? // Admin user ID who approved
  approvedAt      DateTime?
  rejectedBy      String? // Admin user ID who rejected
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  // Organizer data access control (admin-controlled)
  organizerDataAccess DataAccessLevel @default(RESTRICTED) // What data organizers can see

  // Registration code for SMS/USSD registration
  registrationCode String? @unique // Short code for SMS/USSD registration (e.g., "EVENT1")

  // Ticket transfer configuration
  allowTransfers Boolean @default(true)

  // Refund configuration
  refundSLA         Int?    @default(0) // Number of days before event within which refunds are allowed (0 = no refunds)
  autoRefundEnabled Boolean @default(false)
  refundPolicy      String? // 'no_refunds', 'full_refund', 'partial_refund', 'tiered', 'custom'
  refundPolicyText  String? @db.Text // Custom refund policy text shown to attendees
  refundTiers       Json? // Array of {daysBeforeEvent: number, refundPercentage: number} for tiered refunds

  // Service fee configuration
  serviceFeeType           String? // 'percentage', 'fixed', 'none'
  serviceFeeValue          Decimal? @db.Decimal(10, 2) // Fee amount (percentage or fixed)
  serviceFeePassToAttendee Boolean  @default(true) // true = shown at checkout, false = absorbed by organizer

  // Scan configuration
  allowReEntry    Boolean @default(false) // Allow attendees to re-enter after check-out
  requireCheckOut Boolean @default(false) // Require check-out before re-entry
  maxReEntries    Int? // Maximum number of re-entries allowed (null = unlimited)
  scanSettings    Json? // Additional scan settings for future extensibility

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  // Relations
  registrations          EventRegistration[]
  consents               AttendeeConsent[]         @relation("EventConsents")
  invitations            EventInvitation[]
  ticketTemplates        TicketTemplate[]
  featuredEvents         FeaturedEvent[]
  promoCodes             PromoCode[]               @relation("PromoCodeEvent")
  promoCodeRequests      PromoCodeRequest[]        @relation("PromoCodeRequestEvent")
  ticketScans            TicketScan[]
  checkpoints            Checkpoint[]              @relation("EventCheckpoints")
  checkpointScans        CheckpointScan[]          @relation("EventCheckpointScans")
  assignedStaff          EventStaff[]              @relation("EventStaff")
  // Event Payment Relations
  paymentTransactions    EventPaymentTransaction[]
  platformFees           PlatformFee[]
  organizerDisbursements OrganizerDisbursement[]
  refunds                Refund[]
  paymentReconciliations PaymentReconciliation[]
  // Credit/Voucher Relations
  creditTransactions     CreditTransaction[]       @relation("EventCredits")
  vouchers               Voucher[]                 @relation("EventVouchers")
  // Notification Relations
  notifications          Notification[]            @relation("EventNotifications")
  bulkMessages           BulkMessage[]             @relation("EventBulkMessages")
  // User Dashboard Features Relations
  eventReviews           EventReview[]             @relation("EventReviews")
  eventFeedback          EventFeedback[]           @relation("EventFeedback")
  collectionItems        EventCollectionItem[]     @relation("CollectionEvents")
  eventMessages          DirectMessage[]           @relation("EventMessages")
  eventShares            EventShare[]              @relation("EventShares")
  savedByUsers           SavedEvent[]              @relation("EventSaves")
  activityHistory        ActivityHistory[]         @relation("EventActivityHistory")
  feedItems              FeedItem[]                @relation("FeedEvents")
  updateSubscriptions    EventUpdateSubscription[] @relation("EventUpdateSubscriptions")
  invoices               Invoice[]                 @relation("InvoiceEvents")
  paymentPlans           PaymentPlan[]             @relation("PaymentPlanEvents")
  // Affiliate Relations (through Affiliate model)
  // Organizer Dashboard Features Relations
  segments               AttendeeSegment[]         @relation("EventSegments")
  taggedUsers            AttendeeTaggedUser[]      @relation("EventTaggedUsers")
  // Phase 2 Features
  expenses               EventExpense[]            @relation("EventExpenses")
  financialGoals         FinancialGoal[]           @relation("EventFinancialGoals")
  collaborators          EventCollaborator[]       @relation("EventCollaborators")
  activityLogs           EventActivityLog[]        @relation("EventActivityLogs")
  // Phase 3 Features
  ticketPackages         TicketPackage[]           @relation("EventTicketPackages")
  pricingRules           DynamicPricingRule[]      @relation("EventPricingRules")
  affiliatePrograms      AffiliateProgram[]        @relation("EventAffiliatePrograms")
  emailCampaigns         EmailCampaign[]           @relation("EventEmailCampaigns")
  socialPosts            SocialMediaPost[]         @relation("EventSocialPosts")
  teamActivities         TeamActivityFeed[]        @relation("EventTeamActivities")
  platformIncome         PlatformIncome[]          @relation("PlatformIncomeEvents")
  seatMap                SeatMap?                  @relation("EventSeatMap")
  // General Accounting Relations
  incomeEntries          Income[]
  expenseEntries         Expense[]
  // Facility Access Control Relations
  facilityZones          FacilityZone[]
  facilityMovements      FacilityMovement[]
  // Badge/Workstation Relations
  badgeTemplates         BadgeTemplate[]           @relation("EventBadgeTemplates")
  badgePrintJobs         BadgePrintJob[]           @relation("EventBadgePrintJobs")
  // Service Point Facilities
  facilities             EventFacility[]           @relation("EventFacilities")
  printers               Printer[]
  servicePointSessions   ServicePointSession[]     @relation("EventServicePointSessions")
  // Attendee Import History
  attendeeImports        AttendeeImport[]          @relation("EventAttendeeImports")
  // Cart Reservation System
  cartItems              CartItem[]                @relation("CartEvents")
  // Event Reports
  reports                EventReport[]             @relation("EventReports")

  // Resale settings
  allowResale            Boolean                   @default(true)

  @@index([organizerId])
  @@index([status])
  @@index([category])
  @@index([startDate])
  @@index([isFree])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([registrationCode])
}

model EventRegistration {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  attendeeId String
  attendee   User   @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  // Registration link tracking
  invitationId String? // Link used for registration (if registered via invitation link)
  invitation   EventInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  // Registration details
  ticketType  String? // DEPRECATED: Use ticketLineItems instead. Kept for backward compatibility
  quantity    Int     @default(1) // DEPRECATED: Use ticketLineItems instead. Kept for backward compatibility
  totalAmount Decimal @db.Decimal(10, 2) // Total amount paid (0 for free events)

  // Registration form data
  registrationData Json? // Custom form data submitted by attendee
  backupCode       String? // Backup ticket code for manual entry (if QR code fails)

  // QR Code (generated at registration time, like Eventbrite/vf-ticket)
  qrCode            String? // Content/secret of the QR code
  ticketNumber      String? // Visible ticket number
  qrCodeDataUrl     String?   @db.Text // Base64 data URL of QR code image (stored for fast access)
  qrCodeGeneratedAt DateTime? // When QR code was generated
  qrSecret          String?   @default(uuid()) // Secret key for QR validation and easier voiding

  // Status
  status RegistrationStatus @default(PENDING)

  // Payment (for future implementation)
  paymentStatus        String? // PENDING, COMPLETED, FAILED, REFUNDED
  paymentMethod        String? // STRIPE, PAYPAL, etc.
  paymentTransactionId String?

  // Email tracking
  ticketEmailSentAt DateTime? // When ticket email was sent
  ticketEmailStatus String? // SUCCESS, FAILED, PENDING
  ticketEmailError  String? // Error message if email failed

  // Async PDF Generation
  ticketPdfUrl         String? // URL to generated ticket PDF (stored in Cloudinary)
  ticketPdfStatus      String? // PENDING, GENERATING, READY, FAILED
  ticketPdfGeneratedAt DateTime? // When PDF was generated

  // Seating
  seatReservation SeatReservation? @relation("SeatReservation")

  // Scan-related fields
  ticketStatus      TicketStatus @default(ACTIVE) // Ticket status for scanning
  checkedInAt       DateTime? // When ticket was checked in
  checkedInBy       String? // User ID who checked in the ticket
  checkedOutAt      DateTime? // When ticket was checked out
  checkedOutBy      String? // User ID who checked out the ticket
  reEntryCount      Int          @default(0) // Number of re-entries
  lastScanFacility  String? // Last facility/station where ticket was scanned
  isCurrentlyInside Boolean      @default(false) // Whether attendee is currently inside the venue

  // Fraud detection fields (captured at registration time)
  ipAddress         String? // IP address of the registrant
  deviceFingerprint String? // Browser/device fingerprint
  userAgent         String? @db.Text // Browser user agent
  riskScore         Float? // Calculated risk score (0-100)
  riskFlags         Json? // Array of risk indicators

  // Audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  cancelledBy String?

  // Relations
  promoCodeRedemption PromoCodeRedemption?     @relation("PromoCodeRedemption")
  ticketScans         TicketScan[]
  checkpointScans     CheckpointScan[]         @relation("CheckpointScans")
  ticketLineItems     TicketLineItem[] // Multiple ticket types per registration
  // Event Payment Relations
  paymentTransaction  EventPaymentTransaction?
  platformFee         PlatformFee?
  refund              Refund?
  // Notification Relations
  notifications       Notification[]           @relation("RegistrationNotifications")
  // User Dashboard Features Relations
  review              EventReview?             @relation("ReviewRegistration")
  affiliateConversion AffiliateConversion?     @relation("AffiliateRegistration")
  transfers           TicketTransfer[]         @relation("TransferRegistration")
  messages            DirectMessage[]          @relation("MessageRegistration")
  activityHistory     ActivityHistory[]        @relation("RegistrationActivityHistory")
  resale              TicketResale?            @relation("ResaleRegistration")
  walletTicket        WalletTicket?            @relation("WalletRegistration")
  calendarSyncs       EventCalendarSync[]      @relation("CalendarRegistration")
  invoices            Invoice[]                @relation("InvoiceRegistration")
  paymentPlan         PaymentPlan?             @relation("PaymentPlanRegistration")
  // Badge/Workstation Relations
  badgePrintJobs      BadgePrintJob[]
  // Facility Access Control Relations
  zoneAccess          AttendeeZoneAccess[]
  facilityMovements   FacilityMovement[]
  // Printer Integration Relations
  printJobs           PrintJob[]
  // Service Point Registration Session
  servicePointSession ServicePointSession?     @relation("ServicePointRegistration")

  // Consent relations
  consent AttendeeConsent?

  @@unique([eventId, attendeeId]) // One registration per attendee per event
  @@index([eventId])
  @@index([attendeeId])
  @@index([status])
  @@index([createdAt])
  @@index([ticketStatus])
  @@index([checkedInAt])
  @@index([isCurrentlyInside])
}

// Attendee Consent Management
model AttendeeConsent {
  id             String @id @default(uuid())
  attendeeId     String
  eventId        String
  registrationId String @unique

  // Consent flags
  operationalConsent  Boolean @default(true) // Required for ticket delivery
  marketingConsent    Boolean @default(false) // Opt-in for marketing/analytics
  demographicsConsent Boolean @default(false) // Opt-in for demographics (Premium)
  analyticsConsent    Boolean @default(false) // Opt-in for engagement tracking (Premium)

  // Consent metadata
  consentedAt    DateTime  @default(now())
  revokedAt      DateTime?
  consentVersion String    @default("1.0") // Track policy version

  // Relations
  attendee     User              @relation("AttendeeConsents", fields: [attendeeId], references: [id], onDelete: Cascade)
  event        Event             @relation("EventConsents", fields: [eventId], references: [id], onDelete: Cascade)
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
  @@index([eventId])
  @@index([registrationId])
  @@index([marketingConsent])
  @@index([demographicsConsent])
  @@index([analyticsConsent])
}

// Organizer Subscription Management
model OrganizerSubscription {
  id          String           @id @default(uuid())
  organizerId String           @unique
  tier        SubscriptionTier @default(BASIC)
  startedAt   DateTime         @default(now())
  expiresAt   DateTime?
  isActive    Boolean          @default(true)
  canceledAt  DateTime?

  // Billing information (if Premium)
  billingEmail    String?
  nextBillingDate DateTime?

  // Relations
  organizer User @relation("OrganizerSubscriptions", fields: [organizerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([tier])
  @@index([isActive])
  @@index([expiresAt])
}

// Data Access Audit Log
model DataAccessAuditLog {
  id          String   @id @default(uuid())
  organizerId String
  attendeeId  String?
  eventId     String?
  action      String // "VIEW", "EXPORT", "DELETE", "UPDATE", "EMAIL_SENT"
  dataType    String // "ATTENDEE_LIST", "ANALYTICS", "EXPORT", "DEMOGRAPHICS", "ENGAGEMENT"
  timestamp   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  // Additional context
  details Json? // Store additional metadata (export format, filters applied, etc.)

  // Relations
  organizer User @relation("DataAccessAuditLogs", fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([attendeeId])
  @@index([eventId])
  @@index([timestamp])
  @@index([action])
  @@index([dataType])
}

model TicketLineItem {
  id             String            @id @default(uuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  ticketType String // Ticket type name
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2) // Price per ticket
  totalPrice Decimal @db.Decimal(10, 2) // Total price for this line item (unitPrice * quantity)

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([ticketType])
}

model EventInvitation {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Invitation details
  inviteType  InviteType // Type of invitation (ATTENDEE, SPEAKER, EXHIBITOR, GUEST)
  token       String     @unique // Unique shareable token for the registration link
  title       String? // Optional custom title for the link
  description String?    @db.Text // Optional description

  // Link settings
  expiresAt DateTime? // Optional expiration date
  maxUses   Int? // Optional maximum number of uses (null = unlimited)
  usedCount Int       @default(0) // Track how many times the link has been used
  isActive  Boolean   @default(true) // Whether the link is active

  // Organizer who created this invitation
  createdBy String?
  creator   User?   @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?
  revokedBy String?

  // Relations
  registrations EventRegistration[]

  @@index([eventId])
  @@index([token])
  @@index([inviteType])
  @@index([isActive])
  @@index([createdAt])
}

model TicketTemplate {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Template metadata
  name        String // Template name
  description String? @db.Text
  isDefault   Boolean @default(false) // Whether this is the default template for the event

  // Template design
  backgroundUrl String? // Background image URL
  width         Int? // Template width in pixels
  height        Int? // Template height in pixels
  unit          String? // Unit: 'px', 'mm', 'in' (default: 'px')

  // Template elements (JSON array of elements)
  elements Json? // Array of template elements (text, image, QR code, etc.)

  // Created by
  createdBy String?
  creator   User?   @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventId])
  @@index([createdBy])
  @@index([isDefault])
  @@index([createdAt])
}

enum FeaturedItemType {
  EVENT // Featured event from organizer-created events
  IMAGE // Standalone promotional image/picture
}

model FeaturedEvent {
  id   String           @id @default(uuid())
  type FeaturedItemType @default(EVENT) // Type of featured item

  // Event-based featured item (optional)
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Display customization (for event-based items)
  customTitle    String? // Optional custom title (defaults to event.title)
  customImage    String? // Optional custom hero image (defaults to event.image)
  customCategory String? // Optional custom category (defaults to event.category)

  // Standalone image fields (for IMAGE type)
  imageUrl    String? // Image URL for standalone images
  title       String? // Title for standalone images
  description String? @db.Text // Description for standalone images
  linkUrl     String? // Optional link URL when image is clicked
  linkText    String? // Text for the link button (e.g., "Learn More", "Register Now")

  // Display dates - when this featured item should be shown
  displayStartDate DateTime? // When to start showing this featured item
  displayEndDate   DateTime? // When to stop showing this featured item

  // Display order
  displayOrder Int     @default(0) // Lower numbers appear first
  isActive     Boolean @default(true) // Whether this featured item is active

  // Admin who created this featured item
  createdBy String?
  creator   User?   @relation("FeaturedEventCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([eventId])
  @@index([type])
  @@index([createdBy])
  @@index([isActive])
  @@index([displayOrder])
  @@index([displayStartDate])
  @@index([displayEndDate])
  @@index([createdAt])
}

model PromoCode {
  id          String  @id @default(uuid())
  code        String  @unique
  organizerId String? // Null for platform-wide codes created by admin
  eventId     String? // For single-event scope (backward compatible)
  event       Event?  @relation("PromoCodeEvent", fields: [eventId], references: [id], onDelete: Cascade)

  // Scope configuration
  scope    PromoCodeScope @default(EVENT)
  eventIds String[] // For MULTI_EVENT scope - array of event IDs

  // Discount details
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2) // 30 for 30%, or 50 for $50 off
  minOrderAmount Decimal?     @db.Decimal(10, 2) // Minimum purchase required
  maxDiscount    Decimal?     @db.Decimal(10, 2) // Cap on discount amount

  // Applicability
  applicableTicketTypes String[] // Which ticket types it applies to (empty = all)
  isActive              Boolean  @default(true)

  // Advanced features
  firstTimeOnly  Boolean @default(false) // Only for users with no prior purchases
  isStackable    Boolean @default(false) // Can be combined with other codes
  isReferral     Boolean @default(false) // Is this a referral code
  referrerUserId String? // User who owns this referral code

  // Bulk generation
  codePrefix String? // Prefix pattern for bulk codes (e.g., "SUMMER2024")
  batchId    String? // Groups codes generated in same batch

  // Campaign Attribution
  campaignName   String? // e.g., "Summer Sale 2024"
  campaignSource String? // e.g., "Instagram", "Email", "Influencer"

  // Tiered Discounts
  isTiered      Boolean @default(false)
  discountTiers Json? // Array of {minUsage, maxUsage, discountValue, discountType}

  // Limits
  usageLimit     Int? // Max number of uses (null = unlimited)
  usedCount      Int  @default(0)
  maxUsesPerUser Int? @default(1) // How many times one user can use it

  // Validity
  validFrom  DateTime
  validUntil DateTime

  // Tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Admin/organizer who created it

  // Relations
  organizer   User?                 @relation("PromoCodeOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  referrer    User?                 @relation("PromoCodeReferrer", fields: [referrerUserId], references: [id], onDelete: SetNull)
  redemptions PromoCodeRedemption[]
  variants    PromoCodeVariant[]    @relation("PromoCodeVariants")
  request     PromoCodeRequest?     @relation("PromoCodeFromRequest")

  @@index([code])
  @@index([organizerId])
  @@index([eventId])
  @@index([scope])
  @@index([batchId])
  @@index([isActive, validFrom, validUntil])
}

model PromoCodeRedemption {
  id             String            @id @default(uuid())
  promoCodeId    String
  promoCode      PromoCode         @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  registrationId String            @unique
  registration   EventRegistration @relation("PromoCodeRedemption", fields: [registrationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation("PromoCodeUser", fields: [userId], references: [id], onDelete: Cascade)
  discountAmount Decimal           @db.Decimal(10, 2)
  originalAmount Decimal           @db.Decimal(10, 2)
  finalAmount    Decimal           @db.Decimal(10, 2)
  redeemedAt     DateTime          @default(now())

  @@unique([promoCodeId, registrationId])
  @@index([userId])
  @@index([promoCodeId])
}

model TicketScan {
  id             String            @id @default(uuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Core scan fields
  scanType  ScanType // Type of scan operation
  scannedBy String // User ID who performed the scan
  scannedAt DateTime @default(now())

  // Facility tracking
  facility    String? // Facility/station where scan occurred (legacy string field)
  facilityId  String? // Reference to EventFacility
  facilityRef EventFacility? @relation("FacilityScans", fields: [facilityId], references: [id])
  deviceId    String? // Device ID that performed the scan
  deviceType  String? // Type of device (MOBILE, TABLET, DESKTOP, etc.)

  // Validation
  isValid      Boolean @default(true) // Whether scan was valid
  errorCode    String? // Error code if scan failed
  errorMessage String? // Error message if scan failed

  // Re-entry tracking
  isReEntry      Boolean @default(false) // Whether this is a re-entry scan
  previousScanId String? // ID of previous scan (for re-entry chain)

  // Metadata
  ipAddress String? // IP address of scanning device
  userAgent String? // User agent of scanning device
  location  Json? // GPS location data if available

  @@index([registrationId])
  @@index([eventId])
  @@index([scannedAt])
  @@index([scannedBy])
  @@index([facility])
  @@index([facilityId])
}

// ============================================
// Event Facility Model (Service Point Management)
// ============================================

model EventFacility {
  id                String       @id @default(cuid())
  eventId           String
  name              String // e.g., "Main Entrance", "Lunch Area"
  code              String // Short code for quick identification (e.g., "ENT", "L1")
  description       String?
  icon              String? // Icon identifier (e.g., "shield", "utensils", "gift")
  color             String? // Hex color for UI display
  location          String? // Physical location at venue
  isActive          Boolean      @default(true)
  allowCheckIn      Boolean      @default(true)
  allowCheckOut     Boolean      @default(true)
  allowRegistration Boolean      @default(false) // Allow service point registration at this facility
  facilityType      FacilityType @default(CHECK_IN) // Type of facility
  sortOrder         Int          @default(0)

  // Capacity Management
  maxCapacity      Int? // Maximum simultaneous occupancy (null = unlimited)
  currentOccupancy Int  @default(0) // Current number of people in facility

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event                Event                 @relation("EventFacilities", fields: [eventId], references: [id], onDelete: Cascade)
  scans                TicketScan[]          @relation("FacilityScans")
  zones                FacilityZoneMapping[]
  servicePointSessions ServicePointSession[] @relation("FacilityServicePointSessions")

  @@unique([eventId, code])
  @@index([eventId])
  @@index([eventId, isActive])
}

// ============================================
// Checkpoint Models (MICE Event Management)
// ============================================

// Facility type enum (for service point registration)
enum FacilityType {
  CHECK_IN // Check-in only facility
  REGISTRATION // Registration only facility
  HYBRID // Both check-in and registration
}

// Checkpoint type enum
enum CheckpointType {
  DOOR // Entry/Exit (main door)
  MEAL // Food service (breakfast, lunch, dinner)
  GIFT // Gift/swag distribution
  SESSION // Breakout sessions/workshops
  REGISTRATION // Registration desk
  NETWORKING // Networking areas
  EXHIBITION // Exhibition booth visits
  CERTIFICATE // Certificate collection
  CUSTOM // Custom checkpoint type
}

// Checkpoint definition model
model Checkpoint {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation("EventCheckpoints", fields: [eventId], references: [id], onDelete: Cascade)

  // Checkpoint details
  name        String // e.g., "Lunch Day 1", "VIP Gift Bag", "Workshop A"
  type        CheckpointType @default(CUSTOM)
  description String?        @db.Text

  // Location/Station
  location    String? // Physical location at venue
  stationCode String? // Short code for quick identification (e.g., "L1", "G1", "WA")

  // Quota settings (per attendee)
  quota         Int     @default(1) // How many times attendee can scan at this checkpoint (0 = unlimited)
  quotaEnforced Boolean @default(true) // Whether quota is enforced

  // Eligibility rules (JSON for flexibility)
  // Example: { "ticketTypes": ["VIP", "Premium"], "tags": ["speaker"], "all": false }
  eligibilityRules Json? // Defines who can access this checkpoint

  // Time window
  activeFrom DateTime? // When checkpoint opens
  activeTo   DateTime? // When checkpoint closes
  isActive   Boolean   @default(true)

  // Ordering for UI
  displayOrder Int @default(0)

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Admin user ID who created

  // Relations
  scans            CheckpointScan[]
  staffAssignments CheckpointStaff[]

  @@unique([eventId, stationCode])
  @@index([eventId])
  @@index([type])
  @@index([isActive])
  @@index([activeFrom, activeTo])
}

// Checkpoint scan record
model CheckpointScan {
  id             String            @id @default(uuid())
  checkpointId   String
  checkpoint     Checkpoint        @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  registrationId String
  registration   EventRegistration @relation("CheckpointScans", fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event             @relation("EventCheckpointScans", fields: [eventId], references: [id], onDelete: Cascade)

  // Scan info
  scannedBy String // Staff user ID who performed the scan
  scannedAt DateTime @default(now())

  // Validation
  isValid      Boolean @default(true) // Whether scan was valid
  errorCode    String? // Error code if scan failed
  errorMessage String? // Error message if scan failed

  // Quota tracking
  scanNumber Int // Which scan this is (1st, 2nd, etc.) for this attendee at this checkpoint

  // Metadata
  deviceId   String? // Device ID that performed the scan
  deviceType String? // Type of device
  ipAddress  String?
  userAgent  String?
  location   Json? // GPS location if available
  notes      String? // Optional notes by scanner

  @@index([checkpointId])
  @@index([registrationId])
  @@index([eventId])
  @@index([scannedAt])
  @@index([scannedBy])
}

// Staff assignment to checkpoints
model CheckpointStaff {
  id           String     @id @default(uuid())
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  staffId      String
  staff        User       @relation("CheckpointStaffAssignment", fields: [staffId], references: [id], onDelete: Cascade)

  // Assignment details
  assignedAt DateTime @default(now())
  assignedBy String // Admin user ID who assigned

  // Shift scheduling
  shiftStart DateTime?
  shiftEnd   DateTime?
  isActive   Boolean   @default(true)

  @@unique([checkpointId, staffId])
  @@index([checkpointId])
  @@index([staffId])
  @@index([isActive])
}

model EventStaff {
  id         String   @id @default(cuid())
  eventId    String
  staffId    String
  role       String // Event-specific role: "SCANNER", "SUPPORT", "MANAGER", "COORDINATOR", "SUPERVISOR", "TICKET_SELLER"
  staffType  String // "ADMIN_STAFF" or "ORGANIZER_STAFF" - tracks which type of staff
  assignedAt DateTime @default(now())
  assignedBy String // User ID who assigned (admin or organizer)
  notes      String? // Optional notes about assignment
  isActive   Boolean  @default(true)

  // Optional scheduling fields
  shiftStart DateTime? // When staff should start (for multi-day events)
  shiftEnd   DateTime? // When staff should end
  facility   String? // Specific facility/station assignment

  event Event @relation("EventStaff", fields: [eventId], references: [id], onDelete: Cascade)
  staff User  @relation("EventStaff", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([eventId, staffId])
  @@index([eventId])
  @@index([staffId])
  @@index([role])
  @@index([staffType])
  @@index([isActive])
  @@index([assignedAt])
}

// ============================================
// Event Payment Accounting Models
// ============================================

model EventPaymentTransaction {
  id                String @id @default(uuid())
  transactionNumber String @unique // Auto-generated (e.g., "EPT-2024-001")

  // Gateway Details (supports multiple gateways)
  gateway              String   @default("PAYSTACK") // PAYSTACK, STRIPE, PAYPAL
  gatewayReference     String   @unique // Gateway transaction reference
  // Legacy/paystack-specific reference (kept for backward compatibility with older code/tests)
  paystackReference    String?
  paystackAmount       Decimal? @db.Decimal(10, 2) // Legacy amount field (kobo/cents converted)
  gatewayAmount        Decimal  @db.Decimal(10, 2) // Amount from gateway (in smallest unit)
  gatewayTransactionId String? // Gateway's internal transaction ID
  currency             String   @default("NGN")

  // Payment Details
  amount        Decimal   @db.Decimal(10, 2) // Actual amount paid
  paymentMethod String    @default("PAYSTACK")
  paymentStatus String // pending, success, failed, cancelled
  paymentDate   DateTime?

  // Related Entities
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String            @unique
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Attendee Info
  attendeeEmail String
  attendeeName  String?

  // Metadata
  gatewayMetadata Json? // Full gateway response data (replaces paystackMetadata)
  notes           String? @db.Text

  // Idempotency key for preventing duplicate payments
  // Client should send a unique key per payment attempt
  idempotencyKey String? @unique

  // Fraud detection fields
  ipAddress         String? // IP address of the payment initiator
  deviceFingerprint String? // Browser/device fingerprint for fraud detection
  userAgent         String? @db.Text // Browser user agent string
  riskScore         Float? // Calculated risk score (0-100, higher = riskier)
  riskFlags         Json? // Array of risk indicators (e.g., ["vpn_detected", "new_account"])

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  platformFee PlatformFee?
  refund      Refund?
  invoice     Invoice?

  @@index([gatewayReference])
  @@index([gateway])
  @@index([eventId])
  @@index([registrationId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([idempotencyKey])
}

// Payment Webhook Event - Tracks incoming webhook events for idempotency
// Prevents duplicate processing of the same webhook event from payment providers
model PaymentWebhookEvent {
  id String @id @default(uuid())

  // Gateway event identifier (the webhook event ID from Stripe/Paystack)
  // This is the unique identifier for idempotency
  gatewayEventId String @unique

  // Gateway type (STRIPE, PAYSTACK, PAYPAL, etc.)
  gateway String @default("PAYSTACK")

  // Event details
  eventType      String // charge.success, payment_intent.succeeded, etc.
  payload        Json // Full webhook payload for debugging/replay
  reference      String? // Payment reference if applicable
  registrationId String? // Associated registration if applicable

  // Processing status
  status       String   @default("PROCESSED") // PROCESSED, FAILED, IGNORED
  processedAt  DateTime @default(now())
  errorMessage String?  @db.Text

  // Audit
  createdAt DateTime @default(now())

  @@index([gateway])
  @@index([eventType])
  @@index([reference])
  @@index([registrationId])
  @@index([processedAt])
}

// Invoice Generation
model Invoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique // Auto-generated (e.g., "INV-2024-001")

  // Related Entities
  transactionId  String                  @unique
  transaction    EventPaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  registrationId String
  registration   EventRegistration       @relation("InvoiceRegistration", fields: [registrationId], references: [id], onDelete: Restrict)
  eventId        String
  event          Event                   @relation("InvoiceEvents", fields: [eventId], references: [id], onDelete: Restrict)

  // Invoice Details
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  status    String    @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED

  // Amounts
  subtotal       Decimal  @db.Decimal(10, 2)
  taxAmount      Decimal? @db.Decimal(10, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  totalAmount    Decimal  @db.Decimal(10, 2)
  currency       String   @default("NGN")

  // Billing Information
  billToName    String
  billToEmail   String
  billToAddress String? @db.Text
  billToCity    String?
  billToState   String?
  billToCountry String?
  billToZipCode String?

  // Invoice Items
  items InvoiceItem[]

  // Template
  templateId   String? // Reference to invoice template used
  templateData Json? // Template-specific data

  // PDF
  pdfUrl         String? // URL to generated PDF
  pdfGeneratedAt DateTime?

  // Email
  sentAt DateTime?
  sentTo String? // Email address invoice was sent to

  // Notes
  notes String? @db.Text
  terms String? @db.Text // Payment terms

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceNumber])
  @@index([transactionId])
  @@index([registrationId])
  @@index([eventId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Item Details
  description String  @db.Text
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)

  // Optional: Link to ticket type or other entity
  itemType String? // TICKET, FEE, DISCOUNT, etc.
  itemId   String? // ID of related entity (ticket type, etc.)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceTemplate {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text

  // Template Type
  type String @default("STANDARD") // STANDARD, MINIMAL, DETAILED, CUSTOM

  // Template Content
  htmlContent String  @db.Text // HTML template with variables
  cssContent  String? @db.Text // Custom CSS

  // Template Variables
  variables Json? // Available template variables

  // Settings
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  // Usage
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  // Created by
  createdBy String? // Admin user ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isDefault])
  @@index([isActive])
}

// Tax Management
model TaxRate {
  id String @id @default(uuid())

  // Location
  country String
  state   String?
  city    String?

  // Tax Details
  rate    Decimal @db.Decimal(5, 2) // Tax rate percentage (e.g., 7.50 for 7.5%)
  taxType String  @default("SALES_TAX") // VAT, GST, SALES_TAX, etc.

  // Status
  isActive Boolean @default(true)

  // Metadata
  description String? @db.Text
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, state, city], name: "country_state_city")
  @@index([country])
  @@index([state])
  @@index([isActive])
}

model TaxExemption {
  id String @id @default(uuid())

  // Exemption Details
  exemptionType String // ORGANIZATION, INDIVIDUAL, EVENT, etc.
  entityId      String // ID of the exempted entity (user, event, etc.)
  entityType    String // USER, EVENT, etc.

  // Tax Details
  country String
  state   String?
  taxType String? // Specific tax type exempted (null = all taxes)

  // Validity
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  isActive   Boolean   @default(true)

  // Documentation
  exemptionNumber String? // Official exemption number
  certificateUrl  String? // URL to exemption certificate

  // Notes
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, entityType])
  @@index([country])
  @@index([isActive])
  @@index([validUntil])
}

// Webhook Management
model WebhookEndpoint {
  id String @id @default(uuid())

  // Endpoint Details
  name        String
  url         String  @db.Text
  description String? @db.Text

  // Event Types
  eventTypes String[] // Array of event types to subscribe to

  // Configuration
  secret   String? // Secret for webhook signature verification
  isActive Boolean @default(true)

  // Headers (custom headers to send with webhook)
  headers Json? // Custom headers as key-value pairs

  // Retry Configuration
  maxRetries Int @default(3)
  retryDelay Int @default(1000) // Delay in milliseconds

  // Statistics
  successCount    Int       @default(0)
  failureCount    Int       @default(0)
  lastTriggeredAt DateTime?

  // Created by
  createdBy String? // User ID who created this webhook

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deliveries WebhookDelivery[]

  @@index([isActive])
  @@index([createdBy])
  @@index([createdAt])
}

model WebhookDelivery {
  id         String          @id @default(uuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  // Event Details
  eventType String
  eventId   String? // ID of the entity that triggered the event
  payload   Json // Webhook payload data

  // Delivery Status
  status       String @default("PENDING") // PENDING, SUCCESS, FAILED, RETRYING
  attemptCount Int    @default(0)
  maxAttempts  Int    @default(3)

  // Response
  responseCode Int? // HTTP response code
  responseBody String? @db.Text
  errorMessage String? @db.Text

  // Timing
  triggeredAt DateTime  @default(now())
  deliveredAt DateTime?
  nextRetryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpointId])
  @@index([status])
  @@index([eventType])
  @@index([triggeredAt])
  @@index([nextRetryAt])
}

// API Key Management
model ApiKey {
  id String @id @default(uuid())

  // Key Details
  name        String
  keyPrefix   String // First 8 characters of key (for display)
  keyHash     String  @unique // Hashed API key (for verification)
  description String? @db.Text

  // Permissions
  permissions String[] // Array of permission scopes

  // Rate Limiting
  rateLimit       Int @default(100) // Requests per hour
  rateLimitWindow Int @default(3600) // Window in seconds (default 1 hour)

  // Status
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?

  // Usage Statistics
  requestCount  Int       @default(0)
  lastRequestAt DateTime?

  // Created by
  createdBy String? // User ID who created this API key

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  apiRequests ApiRequest[]

  @@index([keyHash])
  @@index([isActive])
  @@index([createdBy])
  @@index([expiresAt])
}

model ApiRequest {
  id       String @id @default(uuid())
  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  // Request Details
  method       String // GET, POST, PUT, DELETE, etc.
  path         String @db.Text
  statusCode   Int
  responseTime Int? // Response time in milliseconds

  // Request Data
  ipAddress   String?
  userAgent   String?
  requestBody Json? // Request body (limited size)

  // Error
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  @@index([apiKeyId])
  @@index([createdAt])
  @@index([statusCode])
  @@index([method, path])
}

// Payment Plans & Installments
model PaymentPlan {
  id String @id @default(uuid())

  // Related Entities
  registrationId String            @unique
  registration   EventRegistration @relation("PaymentPlanRegistration", fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event             @relation("PaymentPlanEvents", fields: [eventId], references: [id], onDelete: Restrict)

  // Plan Details
  planName    String
  totalAmount Decimal @db.Decimal(10, 2)
  currency    String  @default("NGN")

  // Installment Configuration
  installmentCount  Int // Number of installments
  installmentAmount Decimal @db.Decimal(10, 2) // Amount per installment
  frequency         String  @default("MONTHLY") // MONTHLY, WEEKLY, BIWEEKLY, CUSTOM

  // Schedule
  startDate DateTime
  endDate   DateTime

  // Status
  status String @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED, DEFAULTED

  // Auto-payment
  autoPaymentEnabled Boolean @default(true)
  paymentMethod      String? // Payment method for auto-payment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  installments PaymentInstallment[]

  @@index([registrationId])
  @@index([eventId])
  @@index([status])
  @@index([startDate])
}

model PaymentInstallment {
  id     String      @id @default(uuid())
  planId String
  plan   PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Installment Details
  installmentNumber Int // 1, 2, 3, etc.
  amount            Decimal @db.Decimal(10, 2)
  currency          String  @default("NGN")

  // Due Date
  dueDate DateTime

  // Payment
  paidAmount           Decimal?  @db.Decimal(10, 2)
  paidAt               DateTime?
  paymentTransactionId String? // Link to payment transaction

  // Status
  status String @default("PENDING") // PENDING, PAID, OVERDUE, FAILED, CANCELLED

  // Retry
  retryCount  Int       @default(0)
  lastRetryAt DateTime?
  nextRetryAt DateTime?

  // Notes
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@index([dueDate])
  @@index([nextRetryAt])
}

model PlatformFee {
  id        String @id @default(uuid())
  feeNumber String @unique // Auto-generated (e.g., "PF-2024-001")

  // Fee Calculation
  transactionId String                  @unique
  transaction   EventPaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Amounts
  grossAmount     Decimal @db.Decimal(10, 2) // Total payment amount
  feePercentage   Decimal @db.Decimal(5, 2) // Platform fee percentage (e.g., 10.00)
  feeAmount       Decimal @db.Decimal(10, 2) // Calculated platform fee
  organizerAmount Decimal @db.Decimal(10, 2) // Amount to organizer (grossAmount - feeAmount)
  currency        String  @default("NGN")

  // Status
  status       String   @default("calculated") // calculated, disbursed, pending
  calculatedAt DateTime @default(now())

  // Related Entities
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String            @unique
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Disbursement Link
  disbursementId String?
  disbursement   OrganizerDisbursement? @relation(fields: [disbursementId], references: [id], onDelete: SetNull)

  // Metadata
  notes String? @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([registrationId])
  @@index([status])
  @@index([disbursementId])
}

model OrganizerDisbursement {
  id                 String @id @default(uuid())
  disbursementNumber String @unique // Auto-generated (e.g., "DISB-2024-001")

  // Organizer Info
  organizerId String
  organizer   User   @relation("OrganizerDisbursements", fields: [organizerId], references: [id], onDelete: Cascade)

  // Event Info
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Amounts
  totalAmount Decimal @db.Decimal(10, 2) // Total amount to disburse
  currency    String  @default("NGN")

  // Payment Details
  paymentMethod String // bank_transfer, paystack_transfer, etc.
  bankAccount   String? // Bank account details
  bankName      String?
  accountName   String?
  accountNumber String?

  // Status
  status        String    @default("pending") // pending, processing, completed, failed, cancelled
  scheduledDate DateTime? // When to process disbursement
  processedAt   DateTime?
  completedAt   DateTime?

  // Payment Reference
  paymentReference String? // External payment reference (e.g., Paystack transfer reference)
  failureReason    String? @db.Text

  // Platform Fees Included
  platformFees PlatformFee[]

  // Metadata
  notes    String? @db.Text
  metadata Json? // Additional payment metadata

  // Audit
  createdBy String?
  creator   User?    @relation("DisbursementCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([eventId])
  @@index([status])
  @@index([scheduledDate])
}

model Refund {
  id           String @id @default(uuid())
  refundNumber String @unique // Auto-generated (e.g., "REF-2024-001")

  // Related Transaction
  transactionId String                  @unique
  transaction   EventPaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Refund Details
  refundAmount Decimal @db.Decimal(10, 2) // Amount to refund
  currency     String  @default("NGN")
  refundReason String  @db.Text // Reason for refund
  refundType   String // full, partial

  // Status
  status      String    @default("pending") // pending, processing, completed, failed, cancelled
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  // Payment Details
  paymentMethod   String // paystack_refund, manual_refund, etc.
  refundReference String? // External refund reference (e.g., Paystack refund reference)
  failureReason   String? @db.Text

  // Related Entities
  eventId        String
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String            @unique
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Platform Fee Adjustment
  platformFeeRefund Decimal? @db.Decimal(10, 2) // Platform fee to refund/adjust

  // Metadata
  notes    String? @db.Text
  metadata Json? // Additional refund metadata

  // Audit
  requestedBy String?
  requester   User?    @relation("RefundRequester", fields: [requestedBy], references: [id], onDelete: SetNull)
  processedBy String?
  processor   User?    @relation("RefundProcessor", fields: [processedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([transactionId])
  @@index([eventId])
  @@index([registrationId])
  @@index([status])
  @@index([requestedAt])
}

model PaymentReconciliation {
  id                   String @id @default(uuid())
  reconciliationNumber String @unique // Auto-generated (e.g., "REC-2024-001")

  // Reconciliation Period
  startDate          DateTime
  endDate            DateTime
  reconciliationDate DateTime @default(now())

  // Summary
  totalPaystackTransactions Int // Count from Paystack
  totalSystemTransactions   Int // Count from system
  matchedTransactions       Int
  unmatchedTransactions     Int

  // Amounts
  totalPaystackAmount Decimal @db.Decimal(10, 2)
  totalSystemAmount   Decimal @db.Decimal(10, 2)
  discrepancyAmount   Decimal @db.Decimal(10, 2) // Difference

  // Status
  status        String @default("pending") // pending, in_progress, completed, discrepancies_found
  discrepancies Json? // Array of discrepancies found

  // Related Event (if event-specific)
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Metadata
  notes        String? @db.Text
  paystackData Json? // Paystack transaction data used for reconciliation

  // Audit
  reconciledBy String?
  reconciler   User?    @relation("PaymentReconciler", fields: [reconciledBy], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([eventId])
  @@index([status])
}

// ============================================
// Notification & Communication Models
// ============================================

enum NotificationType {
  // Event-related (to attendees)
  EVENT_REMINDER_24H
  EVENT_REMINDER_1H
  EVENT_UPDATE
  EVENT_CANCELLED
  EVENT_POSTPONED
  EVENT_VENUE_CHANGED
  EVENT_TIME_CHANGED
  REGISTRATION_DEADLINE_REMINDER
  REGISTRATION_DEADLINE_24H
  REGISTRATION_DEADLINE_1H
  WAITLIST_AVAILABLE
  CAPACITY_FULL
  EVENT_COMPLETED
  POST_EVENT_SURVEY // Survey request sent 24h after event ends

  // Event-related (to organizers)
  EVENT_APPROVED
  EVENT_REJECTED
  EVENT_CANCELLED_BY_ADMIN
  REGISTRATION_MILESTONE_50
  REGISTRATION_MILESTONE_75
  REGISTRATION_MILESTONE_100
  CAPACITY_REACHED
  PAYMENT_RECEIVED
  REFUND_PROCESSED
  PAYOUT_INITIATED        // Automatic payout created for organizer
  PAYOUT_COMPLETED        // Payout has been completed and sent to organizer
  EVENT_PERFORMANCE_SUMMARY

  // Registration-related
  REGISTRATION_CONFIRMED
  REGISTRATION_CANCELLED
  PAYMENT_PENDING
  PAYMENT_FAILED
  PAYMENT_SUCCESS
  REFUND_RECEIVED

  // Staff-related (Section 3 Phase 3 integration)
  STAFF_ASSIGNED_TO_EVENT
  STAFF_REMOVED_FROM_EVENT
  STAFF_ASSIGNMENT_UPDATED
  EVENT_UPDATE_FOR_STAFF
  EVENT_CANCELLED_FOR_STAFF
  EVENT_REMINDER_FOR_STAFF

  // System notifications
  SYSTEM_ANNOUNCEMENT
  PLATFORM_UPDATE
  MAINTENANCE_SCHEDULED
  SECURITY_ALERT

  // Marketing
  NEW_EVENT_AVAILABLE
  PROMOTION_OFFER
  EARLY_BIRD_REMINDER

  // Account-related
  ACCOUNT_VERIFIED
  PASSWORD_CHANGED
  LOGIN_ATTEMPT
  ACCOUNT_SUSPENDED
  ACCOUNT_ACTIVATED
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum BulkMessageStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum BulkMessageTargetAudience {
  ALL
  ORGANIZERS
  ATTENDEES
  STAFF
  SPECIFIC_EVENT
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  title   String
  message String           @db.Text
  data    Json? // Additional data (eventId, registrationId, etc.)

  // Channels
  channels Json // { email: boolean, sms: boolean, push: boolean, inApp: boolean }

  // Delivery Status
  emailStatus DeliveryStatus?
  smsStatus   DeliveryStatus?
  pushStatus  DeliveryStatus?
  inAppStatus DeliveryStatus? @default(DELIVERED)

  // Read Status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Priority & Expiry
  priority  NotificationPriority @default(MEDIUM)
  expiresAt DateTime?

  // Related Entities
  eventId        String?
  registrationId String?
  relatedUserId  String?

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  event        Event?             @relation("EventNotifications", fields: [eventId], references: [id], onDelete: SetNull)
  registration EventRegistration? @relation("RegistrationNotifications", fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([type])
  @@index([eventId])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([priority])
}

// Email Digest Queue - stores notifications to be sent in daily/weekly digests
model EmailDigestQueue {
  id             String               @id @default(cuid())
  userId         String
  notificationId String
  digestType     String // DAILY, WEEKLY
  priority       NotificationPriority @default(MEDIUM)

  // Notification content (denormalized for digest generation)
  notificationType NotificationType
  title            String
  message          String           @db.Text
  eventId          String?
  eventTitle       String?

  // Status
  status    String    @default("PENDING") // PENDING, SENT, EXPIRED
  sentAt    DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())

  user User @relation("UserDigestQueue", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([digestType, status])
  @@index([createdAt])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  // Channel Preferences
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)
  pushEnabled  Boolean @default(true)
  inAppEnabled Boolean @default(true)

  // Category Preferences
  eventReminders       Boolean @default(true)
  eventUpdates         Boolean @default(true)
  eventCancellations   Boolean @default(true)
  paymentNotifications Boolean @default(true)
  marketingEmails      Boolean @default(true)
  systemAnnouncements  Boolean @default(true)
  registrationUpdates  Boolean @default(true)
  staffNotifications   Boolean @default(true) // For staff assignment notifications

  // Frequency Preferences
  reminderFrequency String @default("all") // all, daily_digest, weekly_digest, none

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserNotificationPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Push Notification Subscriptions for Web Push API
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique // Push service endpoint URL

  // Push subscription keys
  p256dh String // Public key for push encryption
  auth   String // Authentication secret

  // Device/browser info
  userAgent String?
  deviceId  String? // Optional device identifier

  // Status
  isActive  Boolean  @default(true)
  lastUsed  DateTime @default(now())
  failCount Int      @default(0) // Track failed deliveries

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([endpoint])
}

// Mobile Device for FCM Push Notifications
model MobileDevice {
  id     String @id @default(cuid())
  userId String

  // FCM token
  fcmToken String @unique // Firebase Cloud Messaging token

  // Device information
  platform    String // ios, android
  deviceId    String? // Unique device identifier
  deviceModel String? // e.g., "iPhone 14 Pro", "Samsung Galaxy S23"
  osVersion   String? // e.g., "17.0", "14"
  appVersion  String? // App version installed

  // Status
  isActive  Boolean  @default(true)
  lastUsed  DateTime @default(now())
  failCount Int      @default(0) // Track failed deliveries

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserMobileDevices", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([fcmToken])
  @@index([platform])
}

model SystemNotificationSettings {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "default.emailEnabled", "system.smsEnabled"
  value       String   @db.Text // JSON string for complex values, or simple string for primitives
  category    String // e.g., "defaults", "system", "templates", "analytics"
  description String?  @db.Text
  updatedBy   String? // User ID who last updated this setting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedByUser User? @relation("SystemNotificationSettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([category])
  @@index([updatedBy])
}

model SystemSettings {
  id          String  @id @default(cuid())
  key         String  @unique // e.g., "site.name", "email.smtp.host"
  value       String  @db.Text // JSON string for complex values
  type        String // string, number, boolean, json
  category    String // general, users, notifications, security, appearance, email, api, maintenance
  description String? @db.Text
  isPublic    Boolean @default(false) // Can be accessed without auth
  isEncrypted Boolean @default(false) // Sensitive data (passwords, keys)
  environment String? // dev, staging, production (null = all)

  // Audit
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  history SettingsHistory[]

  @@index([key])
  @@index([category])
  @@index([environment])
  @@index([createdBy])
  @@index([updatedBy])
}

// Configuration model - Singleton for system-wide configuration
// Similar to SystemSettings but stores complex configuration objects
model Configuration {
  id String @id @default(cuid())

  // Mail Trap Configuration
  // In development/test environments, emails can be redirected to test addresses
  // Structure: { trap: boolean, toAddress: string[], ccAddress: string[] }
  mailTrap Json @default("{\"trap\":true,\"toAddress\":[],\"ccAddress\":[]}")

  // System Maintenance
  isSystemUnderMaintenance Boolean   @default(false)
  maintenanceMessage       String?   @db.Text
  maintenanceStartTime     DateTime?
  maintenanceEndTime       DateTime?

  // Audit fields
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
  @@index([updatedBy])
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Appearance
  theme           String  @default("system") // light, dark, system
  primaryColor    String? // Custom primary color
  dashboardLayout String  @default("spacious") // compact, spacious
  showMetrics     Boolean @default(true)
  showCharts      Boolean @default(true)
  language        String  @default("en")
  timezone        String?
  dateFormat      String  @default("MM/DD/YYYY")
  timeFormat      String  @default("12h") // 12h, 24h

  // Privacy
  profileVisibility String  @default("public") // public, private, friends
  showEmail         Boolean @default(false)
  showPhone         Boolean @default(false)
  allowMessages     Boolean @default(true)

  // Account
  sessionTimeout Int     @default(30) // minutes
  loginAlerts    Boolean @default(true)
  twoFactorAuth  Boolean @default(false)

  // Organizer-specific
  eventNotifications        Boolean @default(true)
  registrationNotifications Boolean @default(true)
  paymentNotifications      Boolean @default(true)
  marketingEmails           Boolean @default(false)
  weeklyDigest              Boolean @default(true)

  // Attendee-specific
  eventReminders    Boolean @default(true)
  eventUpdates      Boolean @default(true)
  promotionalOffers Boolean @default(true)

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SettingsHistory {
  id           String   @id @default(cuid())
  settingId    String? // SystemSettings ID (if system setting)
  userId       String? // User ID (if user preference)
  key          String // Setting key
  oldValue     String?  @db.Text
  newValue     String   @db.Text
  changedBy    String
  changeReason String?  @db.Text
  createdAt    DateTime @default(now())

  // Relations
  systemSetting SystemSettings? @relation(fields: [settingId], references: [id], onDelete: SetNull)

  @@index([settingId])
  @@index([userId])
  @@index([key])
  @@index([createdAt])
}

// GDPR Data Export Requests
model DataExportRequest {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  status     String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  exportData Json? // Stored export data
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation("DataExportRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model BulkMessage {
  id             String                    @id @default(cuid())
  title          String
  content        String                    @db.Text
  type           String // announcement, marketing, system, event_update
  targetAudience BulkMessageTargetAudience
  eventId        String? // If targeting specific event
  campaignId     String? // Link to marketing campaign
  templateId     String? // Link to email template

  // Channels
  channels Json // { email: boolean, sms: boolean, push: boolean, inApp: boolean }

  // Status
  status      BulkMessageStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?

  // Recipients
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)

  // Engagement tracking
  openedCount       Int @default(0) // Email opens
  clickedCount      Int @default(0) // Link clicks
  unsubscribedCount Int @default(0) // Unsubscribes

  // Created by
  createdBy String?
  creator   User?   @relation("BulkMessageCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event?         @relation("EventBulkMessages", fields: [eventId], references: [id], onDelete: SetNull)
  template EmailTemplate? @relation("BulkMessageTemplate", fields: [templateId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([createdBy])
  @@index([eventId])
  @@index([targetAudience])
  @@index([campaignId])
  @@index([templateId])
}

model EmailTemplate {
  id          String  @id @default(cuid())
  name        String
  subject     String? // Email subject template
  htmlContent String  @db.Text // HTML email template with variables
  textContent String? @db.Text // Plain text version
  description String? @db.Text
  category    String? // campaign, announcement, notification, system
  variables   Json? // Available template variables (e.g., {name}, {eventTitle})
  isActive    Boolean @default(true)
  isDefault   Boolean @default(false)

  // Created by
  createdBy String?
  creator   User?   @relation("EmailTemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // Usage tracking
  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bulkMessages BulkMessage[] @relation("BulkMessageTemplate")

  @@index([category])
  @@index([isActive])
  @@index([createdBy])
}

model SMSSession {
  id          String   @id @default(cuid())
  phoneNumber String // User's phone number
  sessionType String // registration, event_code, support, etc.
  currentStep String? // Current step in conversation flow
  state       Json? // Session state data (user inputs, eventId, etc.)
  eventCode   String? // Event code if registering for specific event
  expiresAt   DateTime // Session expiry (typically 10-15 minutes)
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Payment tracking fields
  paymentRequired      Boolean   @default(false)
  paymentAmount        Decimal?  @db.Decimal(10, 2)
  paymentCurrency      String?   @default("KES")
  paymentStatus        String?   @default("pending") // pending, initiated, completed, failed, cancelled
  paymentGateway       String? // MPESA, PAYSTACK, etc.
  paymentReference     String? // Gateway transaction reference (e.g., CheckoutRequestID)
  paymentReceiptNumber String? // M-Pesa receipt or gateway confirmation
  paymentInitiatedAt   DateTime?
  paymentCompletedAt   DateTime?

  @@index([phoneNumber, sessionType])
  @@index([eventCode])
  @@index([expiresAt])
  @@index([completed])
  @@index([paymentReference])
  @@index([paymentStatus])
}

// USSD Session for real-time USSD interactions (Africa's Talking style)
model USSDSession {
  id          String @id @default(cuid())
  sessionId   String @unique // Provider session ID (from Africa's Talking)
  serviceCode String // USSD service code (e.g., *123#)
  phoneNumber String // User's phone number (MSISDN)

  // Menu navigation
  currentLevel Int      @default(0) // Current menu level
  menuPath     String[] // Path of selections made (e.g., ["1", "2", "3"])
  currentMenu  String   @default("main") // Current menu state

  // Registration data collected
  firstName    String?
  lastName     String?
  email        String?
  jobTitle     String?
  organization String?

  // Event registration
  eventId        String?
  eventCode      String?
  eventTitle     String?
  ticketTypeId   String?
  ticketTypeName String?

  // Payment tracking
  paymentRequired      Boolean   @default(false)
  paymentAmount        Decimal?  @db.Decimal(10, 2)
  paymentCurrency      String?   @default("KES")
  paymentStatus        String?   @default("pending") // pending, initiated, completed, failed, cancelled
  paymentReference     String? // M-Pesa CheckoutRequestID
  paymentReceiptNumber String?
  paymentInitiatedAt   DateTime?
  paymentCompletedAt   DateTime?

  // User linking
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Session state
  completed Boolean  @default(false)
  cancelled Boolean  @default(false)
  expiresAt DateTime // USSD sessions typically last 2-3 minutes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([phoneNumber])
  @@index([eventCode])
  @@index([paymentReference])
  @@index([expiresAt])
}

// Service Point Registration Session (staff-assisted registration with OTP verification)
model ServicePointSession {
  id           String   @id @default(cuid())
  eventId      String
  facilityId   String?
  phoneNumber  String // Attendee's phone number
  otp          String // 4-digit OTP code
  otpExpiresAt DateTime // OTP expiry (typically 5 minutes)
  verified     Boolean  @default(false) // OTP verified
  staffId      String // Staff member who initiated registration

  // Attendee data (collected after OTP verification)
  firstName    String?
  lastName     String?
  email        String?
  company      String?
  industry     String?
  jobTitle     String?
  ticketTypeId String?

  // Registration outcome
  registrationId String? @unique // Link to created registration
  completed      Boolean @default(false)
  cancelled      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  event        Event              @relation("EventServicePointSessions", fields: [eventId], references: [id], onDelete: Cascade)
  facility     EventFacility?     @relation("FacilityServicePointSessions", fields: [facilityId], references: [id], onDelete: SetNull)
  staff        User               @relation("ServicePointStaff", fields: [staffId], references: [id])
  registration EventRegistration? @relation("ServicePointRegistration", fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([phoneNumber])
  @@index([otp])
  @@index([staffId])
  @@index([verified])
  @@index([otpExpiresAt])
}

// ============================================
// Social Media & Support Models
// ============================================

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  LINKEDIN
  YOUTUBE
  WHATSAPP
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum MessageType {
  COMMENT
  DIRECT_MESSAGE
  MENTION
  REVIEW
}

enum SupportQueryStatus {
  NEW
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SocialAccount {
  id            String         @id @default(cuid())
  platform      SocialPlatform
  accountId     String // Platform-specific account ID
  accountName   String
  accountHandle String? // @username or handle
  accessToken   String?        @db.Text // Encrypted
  refreshToken  String?        @db.Text // Encrypted
  tokenExpiry   DateTime?
  followers     Int            @default(0)
  following     Int            @default(0)
  isActive      Boolean        @default(true)
  connectedAt   DateTime       @default(now())
  lastSyncedAt  DateTime?
  metadata      Json? // Additional platform-specific data

  posts     SocialPost[]      @relation("SocialAccountPosts")
  messages  SocialMessage[]   @relation("SocialAccountMessages")
  analytics SocialAnalytics[] @relation("SocialAccountAnalytics")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, accountId])
  @@index([platform])
  @@index([isActive])
}

model SocialPost {
  id              String         @id @default(cuid())
  socialAccountId String
  platform        SocialPlatform
  postId          String? // Platform-specific post ID (null for drafts)
  content         String?        @db.Text
  mediaUrls       Json? // Array of media URLs
  status          PostStatus     @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  campaignId      String? // Link to marketing campaign (future)
  createdBy       String? // User who created the post
  metadata        Json? // Additional platform-specific data

  socialAccount   SocialAccount      @relation("SocialAccountPosts", fields: [socialAccountId], references: [id], onDelete: Cascade)
  metrics         SocialPostMetrics?
  relatedMessages SocialMessage[]    @relation("PostMessages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, postId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([status])
  @@index([scheduledAt])
  @@index([publishedAt])
  @@index([campaignId])
}

model SocialPostMetrics {
  id             String   @id @default(cuid())
  postId         String   @unique
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  views          Int      @default(0)
  clicks         Int      @default(0)
  reach          Int      @default(0)
  impressions    Int      @default(0)
  engagementRate Float? // Calculated: (likes + comments + shares) / reach
  lastUpdated    DateTime @default(now()) @updatedAt

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([lastUpdated])
}

model SocialMessage {
  id              String             @id @default(cuid())
  socialAccountId String
  platform        SocialPlatform
  messageId       String // Platform-specific message ID
  senderId        String // Platform-specific sender ID
  senderName      String
  senderHandle    String?
  senderEmail     String?
  message         String             @db.Text
  messageType     MessageType
  postId          String? // If related to a post
  status          SupportQueryStatus @default(NEW)
  priority        SupportPriority    @default(MEDIUM)
  category        String? // e.g., "billing", "technical", "general"
  assignedTo      String? // User ID of assigned agent
  assignedAt      DateTime?
  resolvedAt      DateTime?
  campaignId      String? // Link to marketing campaign if query related
  metadata        Json? // Additional platform-specific data

  socialAccount SocialAccount     @relation("SocialAccountMessages", fields: [socialAccountId], references: [id], onDelete: Cascade)
  socialPost    SocialPost?       @relation("PostMessages", fields: [postId], references: [id], onDelete: SetNull)
  assignedAgent User?             @relation("AssignedSupportQueries", fields: [assignedTo], references: [id], onDelete: Restrict)
  responses     SupportResponse[] @relation("MessageResponses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, messageId])
  @@index([socialAccountId])
  @@index([platform])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
  @@index([postId])
  @@index([createdAt])
}

model SupportResponse {
  id         String   @id @default(cuid())
  messageId  String
  response   String   @db.Text
  sentBy     String // User ID of agent who sent response
  sentAt     DateTime @default(now())
  isInternal Boolean  @default(false) // Internal note vs customer-facing response
  metadata   Json? // Additional data (delivery status, etc.)

  message SocialMessage @relation("MessageResponses", fields: [messageId], references: [id], onDelete: Cascade)
  agent   User          @relation("SupportResponses", fields: [sentBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([sentBy])
  @@index([sentAt])
}

model SocialAnalytics {
  id              String         @id @default(cuid())
  socialAccountId String
  date            DateTime       @db.Date
  platform        SocialPlatform
  followers       Int            @default(0)
  following       Int            @default(0)
  posts           Int            @default(0)
  likes           Int            @default(0)
  comments        Int            @default(0)
  shares          Int            @default(0)
  views           Int            @default(0)
  reach           Int            @default(0)
  impressions     Int            @default(0)
  engagement      Int            @default(0) // Total engagements
  metadata        Json? // Additional metrics

  socialAccount SocialAccount @relation("SocialAccountAnalytics", fields: [socialAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([socialAccountId, date, platform])
  @@index([socialAccountId])
  @@index([date])
  @@index([platform])
}

// ============================================
// User Dashboard Features Models
// ============================================

// Event Reviews & Ratings
model EventReview {
  id             String             @id @default(uuid())
  eventId        String
  event          Event              @relation("EventReviews", fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  registrationId String?            @unique // Link to registration if reviewed after attending   
  registration   EventRegistration? @relation("ReviewRegistration", fields: [registrationId], references: [id], onDelete: SetNull)

  rating Int // 1-5 stars
  title  String?  @db.Text
  review String?  @db.Text
  pros   String[] // Array of pros
  cons   String[] // Array of cons

  // Moderation
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED, FLAGGED
  moderatedBy      String?
  moderatedAt      DateTime?
  moderationReason String?   @db.Text

  // Engagement
  helpfulCount Int @default(0) // Number of users who found this helpful
  reportCount  Int @default(0) // Number of times reported

  // Metadata
  isVerifiedAttendee Boolean   @default(false) // Verified that user attended
  attendedDate       DateTime? // When user attended the event

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId]) // One review per user per event
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
}

// Platform Feedback (Internal use for platform improvement)
model EventFeedback {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation("EventFeedback", fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("UserFeedback", fields: [userId], references: [id], onDelete: Cascade)

  // Feedback type
  userType String // "ATTENDEE" | "ORGANIZER"

  // NPS Score (0-10)
  npsScore Int // 0-10 Net Promoter Score

  // Optional detailed feedback
  comment String? @db.Text

  // Specific feedback categories
  eventQuality         Int? // 1-5 rating for event quality
  platformUsability    Int? // 1-5 rating for platform ease of use
  registrationProcess  Int? // 1-5 rating for registration experience
  communicationQuality Int? // 1-5 rating for event communications

  // What could be improved (multi-select options stored as array)
  improvementAreas String[] // e.g., ["registration", "payments", "notifications", "ui"]

  // Would they use the platform again
  wouldUseAgain  Boolean?
  wouldRecommend Boolean?

  // Email tracking
  emailSentAt    DateTime?
  feedbackToken  String?   @unique // Token for email-based feedback submission
  tokenExpiresAt DateTime?
  submittedVia   String    @default("PLATFORM") // "EMAIL" | "PLATFORM"

  // Admin review
  reviewedBy String?
  reviewedAt DateTime?
  adminNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId]) // One feedback per user per event
  @@index([eventId])
  @@index([userId])
  @@index([userType])
  @@index([npsScore])
  @@index([createdAt])
  @@index([feedbackToken])
}

// Ticket Transfer
model TicketTransfer {
  id             String            @id @default(uuid())
  registrationId String
  registration   EventRegistration @relation("TransferRegistration", fields: [registrationId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User    @relation("TicketTransfersFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId   String?
  toUser     User?   @relation("TicketTransfersTo", fields: [toUserId], references: [id], onDelete: Restrict)
  toEmail    String? // Email if transferring to non-user

  // Transfer details
  transferToken String  @unique // Unique token for transfer acceptance
  status        String  @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  message       String? @db.Text // Optional message from sender

  // Approval workflow
  requiresApproval Boolean   @default(false) // If organizer requires approval
  approvedBy       String? // User ID who approved (if required)
  approvedAt       DateTime?

  // Expiration
  expiresAt   DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  // Transfer chain
  parentTransferId String?
  parentTransfer   TicketTransfer?  @relation("TransferChain", fields: [parentTransferId], references: [id], onDelete: SetNull)
  childTransfers   TicketTransfer[] @relation("TransferChain")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@index([transferToken])
  @@index([expiresAt])
}

// Event Collections
model EventCollection {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserCollections", fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  isPublic    Boolean @default(false)
  coverImage  String?

  // Sharing
  shareToken String? @unique // Token for sharing collections
  isShared   Boolean @default(false)

  // Metadata
  eventCount    Int @default(0)
  followerCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    EventCollectionItem[]
  followers CollectionFollower[]

  @@index([userId])
  @@index([isPublic])
  @@index([shareToken])
}

model EventCollectionItem {
  id           String          @id @default(uuid())
  collectionId String
  collection   EventCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event           @relation("CollectionEvents", fields: [eventId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())
  notes   String?  @db.Text // User's personal notes about this event

  @@unique([collectionId, eventId])
  @@index([collectionId])
  @@index([eventId])
}

model CollectionFollower {
  id           String          @id @default(uuid())
  collectionId String
  collection   EventCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation("CollectionFollows", fields: [userId], references: [id], onDelete: Cascade)

  followedAt DateTime @default(now())

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
}

// Ticket Resale Marketplace
model TicketResale {
  id             String            @id @default(uuid())
  registrationId String            @unique
  registration   EventRegistration @relation("ResaleRegistration", fields: [registrationId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("TicketResales", fields: [sellerId], references: [id], onDelete: Restrict)

  // Pricing
  originalPrice Decimal @db.Decimal(10, 2)
  resalePrice   Decimal @db.Decimal(10, 2)
  currency      String  @default("NGN")

  // Status
  status           String    @default("LISTED") // LISTED, RESERVED, SOLD, CANCELLED, EXPIRED
  listedAt         DateTime  @default(now())
  soldAt           DateTime?
  reservedAt       DateTime? // When a buyer reserved the listing
  paymentReference String?   // Payment gateway reference
  paymentStatus    String?   // PENDING, COMPLETED, FAILED

  // Buyer (if sold)
  buyerId String?
  buyer   User?   @relation("TicketResalePurchases", fields: [buyerId], references: [id], onDelete: SetNull)

  // Platform fee
  platformFee  Decimal? @db.Decimal(10, 2)
  sellerPayout Decimal? @db.Decimal(10, 2)

  // Expiration
  expiresAt DateTime? // Auto-expire if event is too close

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@index([listedAt])
  @@index([expiresAt])
}

// Event Report (user-submitted reports about events)
model EventReport {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation("EventReports", fields: [eventId], references: [id], onDelete: Cascade)
  reportedBy  String
  reporter    User     @relation("EventReports", fields: [reportedBy], references: [id], onDelete: Cascade)

  category    String   // e.g. SPAM, FRAUD, INAPPROPRIATE, OTHER
  description String?
  status      String   @default("PENDING") // PENDING, INVESTIGATING, RESOLVED, DISMISSED
  submittedIp String?
  userAgent   String?

  reviewNotes String?
  reviewedBy  String?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, reportedBy])
  @@index([eventId])
  @@index([reportedBy])
  @@index([status])
  @@index([category])
}

// User Credit Balance
model UserCredit {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation("UserCredits", fields: [userId], references: [id], onDelete: Cascade)
  balance  Decimal @default(0) @db.Decimal(12, 2) // Current credit balance
  currency String  @default("NGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CreditTransaction[]

  @@index([userId])
}

// Credit Transaction History
model CreditTransaction {
  id       String     @id @default(uuid())
  creditId String
  credit   UserCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  // Transaction details
  type          String // CREDIT, DEBIT, EXPIRED, ADJUSTMENT
  amount        Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2) // Balance after this transaction
  description   String
  reference     String? // Reference to related entity (refund ID, order ID, etc.)
  referenceType String? // REFUND, PURCHASE, ADMIN_GRANT, PROMO, EXPIRY

  // Voucher/Credit source info
  voucherCode String? // If from a voucher
  expiresAt   DateTime? // When this credit expires

  // Who initiated the transaction
  initiatedBy String?
  initiator   User?   @relation("CreditInitiator", fields: [initiatedBy], references: [id], onDelete: SetNull)

  // Event association (if applicable)
  eventId String?
  event   Event?  @relation("EventCredits", fields: [eventId], references: [id], onDelete: SetNull)

  metadata  Json?
  createdAt DateTime @default(now())

  @@index([creditId])
  @@index([type])
  @@index([createdAt])
  @@index([voucherCode])
}

// Voucher Codes (for credit distribution)
model Voucher {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  // Credit amount
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("NGN")

  // Usage limits
  maxUses     Int? // Max number of redemptions (null = unlimited)
  usedCount   Int  @default(0)
  usesPerUser Int  @default(1) // How many times same user can use

  // Validity
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  isActive   Boolean   @default(true)

  // Restrictions
  eventId           String? // Restrict to specific event
  event             Event?   @relation("EventVouchers", fields: [eventId], references: [id], onDelete: SetNull)
  organizerId       String? // Created by organizer
  organizer         User?    @relation("OrganizerVouchers", fields: [organizerId], references: [id], onDelete: SetNull)
  minPurchaseAmount Decimal? @db.Decimal(12, 2) // Minimum purchase to apply

  // Who created the voucher
  createdBy String?
  creator   User?   @relation("VoucherCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions VoucherRedemption[]

  @@index([code])
  @@index([eventId])
  @@index([organizerId])
  @@index([validUntil])
}

// Voucher Redemption Log
model VoucherRedemption {
  id        String  @id @default(uuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("VoucherRedemptions", fields: [userId], references: [id], onDelete: Cascade)

  // Redemption details
  amount  Decimal @db.Decimal(12, 2) // Amount credited
  orderId String? // Related order if applied at checkout
  eventId String? // Event where voucher was applied

  createdAt DateTime @default(now())

  @@unique([voucherId, userId]) // Ensure user can only redeem once (or usesPerUser times)
  @@index([voucherId])
  @@index([userId])
}

// Digital Wallet (Ticket Storage)
model DigitalWallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserDigitalWallet", fields: [userId], references: [id], onDelete: Cascade)

  // Wallet preferences
  autoAddTickets Boolean @default(true) // Automatically add tickets to wallet
  backupEnabled  Boolean @default(true) // Enable cloud backup

  // Apple Wallet / Google Pay integration
  appleWalletId String? // Apple Wallet pass identifier
  googlePayId   String? // Google Pay pass identifier

  // Last sync
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  walletTickets WalletTicket[]

  @@index([userId])
}

model WalletTicket {
  id             String            @id @default(uuid())
  walletId       String
  wallet         DigitalWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  registrationId String            @unique
  registration   EventRegistration @relation("WalletRegistration", fields: [registrationId], references: [id], onDelete: Cascade)

  // Wallet-specific data
  passData   Json? // Apple/Google Pay pass data
  qrCodeUrl  String? // QR code for offline access
  backupCode String? // Backup code for recovery

  // Status
  isActive       Boolean   @default(true)
  addedAt        DateTime  @default(now())
  lastAccessedAt DateTime?

  @@index([walletId])
  @@index([registrationId])
  @@index([isActive])
}

// Event Calendar Integration
model EventCalendarSync {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation("UserCalendarSyncs", fields: [userId], references: [id], onDelete: Cascade)
  registrationId String
  registration   EventRegistration @relation("CalendarRegistration", fields: [registrationId], references: [id], onDelete: Cascade)

  // Calendar type
  calendarType String // GOOGLE, APPLE, OUTLOOK, ICAL
  calendarId   String? // External calendar event ID

  // Sync status
  syncedAt     DateTime  @default(now())
  lastSyncedAt DateTime?
  syncStatus   String    @default("ACTIVE") // ACTIVE, FAILED, DISABLED

  // Reminder settings
  reminderEnabled Boolean @default(true)
  reminderMinutes Int? // Minutes before event (e.g., 15, 30, 60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, registrationId, calendarType])
  @@index([userId])
  @@index([registrationId])
  @@index([calendarType])
  @@index([syncStatus])
}

// Personal Event Feed
model PersonalEventFeed {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("UserEventFeed", fields: [userId], references: [id], onDelete: Cascade)

  // Feed preferences
  preferences Json // Feed customization settings
  filters     Json? // Feed filtering options (categories, locations, etc.)

  // Feed items (cached)
  feedItems FeedItem[]

  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model FeedItem {
  id      String            @id @default(uuid())
  feedId  String
  feed    PersonalEventFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  eventId String
  event   Event             @relation("FeedEvents", fields: [eventId], references: [id], onDelete: Cascade)

  // Item metadata
  relevanceScore Decimal? @db.Decimal(5, 2) // AI relevance score
  reason         String? // Why this event is in the feed (e.g., "Based on your interests")

  // User interaction
  viewed      Boolean   @default(false)
  viewedAt    DateTime?
  dismissed   Boolean   @default(false)
  dismissedAt DateTime?

  addedAt DateTime @default(now())

  @@unique([feedId, eventId])
  @@index([feedId])
  @@index([eventId])
  @@index([viewed])
  @@index([addedAt])
}

// Event Updates Subscription
model EventUpdateSubscription {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation("UserEventSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation("EventUpdateSubscriptions", fields: [eventId], references: [id], onDelete: Cascade)

  // Subscription preferences
  updateTypes String[] // Types of updates to receive: SCHEDULE, VENUE, CANCELLATION, ANNOUNCEMENT, etc.
  channels    String[] // Notification channels: EMAIL, PUSH, IN_APP, SMS

  // Status
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([isActive])
}

// User Interests
model UserInterest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserInterests", fields: [userId], references: [id], onDelete: Cascade)

  category    String // Event category
  subcategory String? // Optional subcategory
  tags        String[] // Array of interest tags

  // Weight/preference
  weight Int @default(1) // 1-10, how much user likes this

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
  @@index([category])
}

// Direct Messaging
model DirectMessage {
  id          String @id @default(uuid())
  senderId    String
  sender      User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User   @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  // Message content
  subject String?   @db.Text
  content String    @db.Text
  isRead  Boolean   @default(false)
  readAt  DateTime?

  // Related entities
  eventId        String? // If message is about an event
  event          Event?             @relation("EventMessages", fields: [eventId], references: [id], onDelete: SetNull)
  registrationId String? // If message is about a registration
  registration   EventRegistration? @relation("MessageRegistration", fields: [registrationId], references: [id], onDelete: SetNull)

  // Threading
  parentMessageId String? // For replies
  parentMessage   DirectMessage?  @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies         DirectMessage[] @relation("MessageReplies")

  // Status
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([recipientId])
  @@index([eventId])
  @@index([isRead])
  @@index([createdAt])
}

// User Follows (Social Networking)
model UserFollow {
  id          String @id @default(uuid())
  followerId  String
  follower    User   @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  followedAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// Event Shares (Tracking)
model EventShare {
  id      String  @id @default(uuid())
  eventId String
  event   Event   @relation("EventShares", fields: [eventId], references: [id], onDelete: Cascade)
  userId  String? // User who shared (null if anonymous)
  user    User?   @relation("UserShares", fields: [userId], references: [id], onDelete: SetNull)

  // Share details
  platform String // facebook, twitter, email, whatsapp, link, etc.
  shareUrl String? // URL that was shared
  referrer String? // Where the share came from

  // Tracking
  clickCount      Int @default(0) // Number of clicks on shared link
  conversionCount Int @default(0) // Number of registrations from this share

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([userId])
  @@index([platform])
  @@index([createdAt])
}

// Saved Searches
model SavedSearch {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("SavedSearches", fields: [userId], references: [id], onDelete: Cascade)

  name        String
  searchQuery String @db.Text // JSON string of search parameters
  filters     Json? // Search filters

  // Notifications
  notifyOnNewEvents     Boolean @default(false)
  notificationFrequency String  @default("DAILY") // DAILY, WEEKLY, NEVER

  lastSearchedAt DateTime?
  resultCount    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([notifyOnNewEvents])
}

// Saved Events (Bookmarks)
model SavedEvent {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation("UserSavedEvents", fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation("EventSaves", fields: [eventId], references: [id], onDelete: Cascade)

  savedAt DateTime @default(now())
  notes   String?  @db.Text // Optional personal notes

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([savedAt])
}

// Activity History
model ActivityHistory {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("UserActivityHistory", fields: [userId], references: [id], onDelete: Cascade)

  activityType String // REGISTRATION, PAYMENT, TICKET_DOWNLOAD, REVIEW, TRANSFER, etc.
  entityType   String // EVENT, REGISTRATION, PAYMENT, etc.
  entityId     String

  // Details
  title       String
  description String? @db.Text
  metadata    Json? // Additional activity data

  // Related entities
  eventId        String?
  event          Event?             @relation("EventActivityHistory", fields: [eventId], references: [id], onDelete: SetNull)
  registrationId String?
  registration   EventRegistration? @relation("RegistrationActivityHistory", fields: [registrationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([activityType])
  @@index([entityType])
  @@index([createdAt])
  @@index([eventId])
}

// Event Templates
model EventTemplate {
  id          String @id @default(uuid())
  organizerId String
  organizer   User   @relation("OrganizerTemplates", fields: [organizerId], references: [id], onDelete: Cascade)

  name        String
  description String?  @db.Text
  category    String?
  tags        String[]

  // Template data (stores event structure)
  templateData Json // Stores all event fields that can be templated

  // Sharing
  isPublic   Boolean @default(false)
  isShared   Boolean @default(false)
  shareToken String? @unique

  // Versioning
  version  Int             @default(1)
  parentId String? // For versioning - links to parent template
  parent   EventTemplate?  @relation("TemplateVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions EventTemplate[] @relation("TemplateVersions")

  // Usage tracking
  usageCount Int       @default(0)
  lastUsedAt DateTime?

  // Metadata
  thumbnail String? // Template preview image

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizerId])
  @@index([isPublic])
  @@index([category])
  @@index([shareToken])
  @@index([parentId])
  @@index([createdAt])
}

// Event Drafts
model EventDraft {
  id          String @id @default(uuid())
  organizerId String
  organizer   User   @relation("OrganizerDrafts", fields: [organizerId], references: [id], onDelete: Cascade)

  // Draft data
  draftData Json // Stores all event fields

  // Versioning
  version  Int          @default(1)
  parentId String? // For versioning
  parent   EventDraft?  @relation("DraftVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions EventDraft[] @relation("DraftVersions")

  // Scheduling
  scheduledPublishAt DateTime? // When to auto-publish

  // Collaboration
  collaborators Json? // Array of user IDs with permissions

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime? // When draft was published
  deletedAt   DateTime?

  @@index([organizerId])
  @@index([parentId])
  @@index([scheduledPublishAt])
  @@index([createdAt])
}

// Attendee Segmentation
model AttendeeSegment {
  id          String  @id @default(uuid())
  organizerId String
  organizer   User    @relation("OrganizerSegments", fields: [organizerId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?  @relation("EventSegments", fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  // Segment criteria (JSON for flexibility)
  criteria Json // e.g., { tags: ["VIP"], registrationDate: { before: "2024-01-01" }, totalSpent: { min: 100 } }

  // Auto-update
  isDynamic Boolean @default(true) // If true, segment updates automatically based on criteria

  memberCount Int @default(0) // Cached count

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members AttendeeSegmentMember[]

  @@index([organizerId])
  @@index([eventId])
  @@index([isDynamic])
  @@index([createdAt])
}

model AttendeeSegmentMember {
  id        String          @id @default(uuid())
  segmentId String
  segment   AttendeeSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("SegmentMembers", fields: [userId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([segmentId, userId])
  @@index([segmentId])
  @@index([userId])
}

// Attendee Tags
model AttendeeTag {
  id          String @id @default(uuid())
  organizerId String
  organizer   User   @relation("OrganizerTags", fields: [organizerId], references: [id], onDelete: Cascade)

  name        String
  color       String? // Hex color for UI
  description String? @db.Text

  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  taggedUsers AttendeeTaggedUser[]

  @@unique([organizerId, name])
  @@index([organizerId])
  @@index([name])
}

model AttendeeTaggedUser {

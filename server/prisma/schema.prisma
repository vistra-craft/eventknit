  event             Event     @relation("EventAttendeeImports", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

model FacilityZone {
  id               String                @id @default(cuid())
  eventId          String
  name             String
  code             String
  description      String?
  maxCapacity      Int?
  currentOccupancy Int                   @default(0)
  accessStart      DateTime?
  accessEnd        DateTime?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  attendeeAccess   AttendeeZoneAccess[]
  movementsFrom    FacilityMovement[]    @relation("MovementFrom")
  movementsTo      FacilityMovement[]    @relation("MovementTo")
  event            Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  facilities       FacilityZoneMapping[]

  @@unique([eventId, code])
  @@index([eventId, isActive])
}

model FacilityZoneMapping {
  id         String        @id @default(cuid())
  facilityId String
  zoneId     String
  createdAt  DateTime      @default(now())
  facility   EventFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  zone       FacilityZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([facilityId, zoneId])
  @@index([facilityId])
  @@index([zoneId])
}

model AttendeeZoneAccess {
  id             String            @id @default(cuid())
  registrationId String
  zoneId         String
  grantedAt      DateTime          @default(now())
  grantedBy      String
  expiresAt      DateTime?
  isActive       Boolean           @default(true)
  accessCount    Int               @default(0)
  lastAccessAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  zone           FacilityZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([registrationId, zoneId])
  @@index([registrationId])
  @@index([zoneId, isActive])
}

model FacilityMovement {
  id             String            @id @default(cuid())
  registrationId String
  eventId        String
  fromZoneId     String?
  toZoneId       String
  movementType   String
  sequenceNumber Int
  scannedAt      DateTime          @default(now())
  scannedBy      String
  deviceInfo     Json?
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromZone       FacilityZone?     @relation("MovementFrom", fields: [fromZoneId], references: [id])
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  toZone         FacilityZone      @relation("MovementTo", fields: [toZoneId], references: [id], onDelete: Cascade)

  @@index([registrationId, scannedAt])
  @@index([eventId, scannedAt])
  @@index([fromZoneId])
  @@index([toZoneId])
}

model Printer {
  id             String     @id @default(cuid())
  eventId        String?
  name           String
  driver         String
  deviceId       String
  host           String?
  port           Int?
  apiKey         String?
  supportedSizes String[]
  paperSize      String?
  orientation    String?
  isOnline       Boolean    @default(false)
  isActive       Boolean    @default(true)
  lastChecked    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdBy      String
  printJobs      PrintJob[]
  event          Event?     @relation(fields: [eventId], references: [id])

  @@index([eventId, isActive])
  @@index([driver, isOnline])
}

model PrintJob {
  id             String            @id @default(cuid())
  printerId      String
  templateId     String
  registrationId String
  status         String            @default("queued")
  priority       Int               @default(0)
  copies         Int               @default(1)
  pdfUrl         String?
  sentToPrinter  DateTime?
  printedAt      DateTime?
  retryCount     Int               @default(0)
  maxRetries     Int               @default(3)
  errorMessage   String?
  jobMetadata    Json?
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  printer        Printer           @relation(fields: [printerId], references: [id], onDelete: Cascade)
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  template       BadgeTemplate     @relation(fields: [templateId], references: [id])

  @@index([printerId, status])
  @@index([status, priority, createdAt])
  @@index([registrationId])
  @@index([templateId])
  @@index([createdAt])
}

model CartReservation {
  id          String     @id @default(uuid())
  userId      String?
  sessionId   String     @unique
  fingerprint String?
  status      CartStatus @default(ACTIVE)
  expiresAt   DateTime
  reservedAt  DateTime?
  completedAt DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       CartItem[]
  user        User?      @relation("UserCarts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
}

model CartItem {
  id              String          @id @default(uuid())
  cartId          String
  eventId         String
  ticketType      String
  quantity        Int             @default(1)
  unitPrice       Decimal         @db.Decimal(10, 2)
  seatIds         String[]
  promoCodeId     String?
  discountAmount  Decimal?        @db.Decimal(10, 2)
  inventoryLocked Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cart            CartReservation @relation(fields: [cartId], references: [id], onDelete: Cascade)
  event           Event           @relation("CartEvents", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([eventId])
  @@index([ticketType])
}

model CareerInquiry {
  id          String    @id @default(uuid())
  email       String
  firstName   String?
  status      String    @default("PENDING")
  emailSentAt DateTime  @default(now())
  respondedAt DateTime?
  notes       String?
  reviewedBy  String?
  reviewedAt  DateTime?
  source      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model EventApprovalMessage {
  id                String                   @id @default(uuid())
  eventId           String
  organizerId       String
  type              EventApprovalMessageType
  title             String
  message           String
  senderRole        String
  senderName        String
  senderEmail       String?
  attachedDocuments String[]
  status            MessageStatus            @default(PENDING)
  responseMessage   String?
  respondedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  event             Event                    @relation("EventApprovalMessages", fields: [eventId], references: [id], onDelete: Cascade)
  organizer         User                     @relation("OrganizerApprovalMessages", fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([organizerId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

/// Organizer-designed post-event survey.
/// Each event can have one active survey with configurable sections and custom questions.
model EventSurvey {
  id                   String           @id @default(uuid())
  eventId              String           @unique
  createdById          String
  title                String           @default("Event Feedback Survey")
  description          String?
  includeNps           Boolean          @default(false)
  includeVenueRating   Boolean          @default(false)
  includeSpeakerRating Boolean          @default(false)
  includeContentRating Boolean          @default(false)
  includeOrgRating     Boolean          @default(false)
  includeValueRating   Boolean          @default(false)
  customQuestions      Json?
  triggerAfterHours    Int              @default(24)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdBy            User             @relation("SurveyCreator", fields: [createdById], references: [id])
  event                Event            @relation("EventSurveys", fields: [eventId], references: [id], onDelete: Cascade)
  responses            SurveyResponse[] @relation("SurveyResponses")

  @@index([createdById])
  @@index([isActive])
}

/// Individual attendee response to an event survey.
model SurveyResponse {
  id             String             @id @default(uuid())
  surveyId       String
  eventId        String
  attendeeId     String
  registrationId String?            @unique
  overallRating  Int
  npsScore       Int?
  venueRating    Int?
  speakerRating  Int?
  contentRating  Int?
  orgRating      Int?
  valueRating    Int?
  customAnswers  Json?
  comment        String?
  submittedAt    DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attendee       User               @relation("UserSurveyResponses", fields: [attendeeId], references: [id], onDelete: Cascade)
  event          Event              @relation("EventSurveyResponses", fields: [eventId], references: [id], onDelete: Cascade)
  registration   EventRegistration? @relation("SurveyRegistration", fields: [registrationId], references: [id])
  survey         EventSurvey        @relation("SurveyResponses", fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, attendeeId])
  @@index([eventId])
  @@index([attendeeId])
  @@index([overallRating])
  @@index([submittedAt])
}

model CompanyDocument {
  id                 String             @id @default(uuid())
  name               String
  description        String?
  category           CompanyDocCategory
  type               CompanyDocType
  fileUrl            String?
  cloudinaryPublicId String?
  externalUrl        String?
  fileName           String?
  fileSize           Int?
  mimeType           String?
  uploadedById       String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  uploadedBy         User               @relation("CompanyDocUploader", fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([category])
  @@index([type])
  @@index([createdAt])
}

model EventForm {
  id                     String           @id @default(uuid())
  eventId                String?
  createdById            String
  title                  String
  description            String?
  purpose                FormPurpose      @default(CUSTOM)
  customPurpose          String?
  targetParticipantType  ParticipantType?
  status                 FormStatus       @default(DRAFT)
  questions              Json             @default("[]")
  shareToken             String           @unique @default(uuid())
  isPublic               Boolean          @default(false)
  allowMultipleResponses Boolean          @default(false)
  maxResponses           Int?
  closesAt               DateTime?
  notifyOnSubmission     Boolean          @default(true)
  notificationEmail      String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  theme                  Json?
  createdBy              User             @relation("FormCreator", fields: [createdById], references: [id])
  event                  Event?           @relation("EventForms", fields: [eventId], references: [id])
  responses              FormResponse[]   @relation("FormResponses")

  @@index([eventId])
  @@index([createdById])
  @@index([status])
  @@index([purpose])
  @@index([shareToken])
}

model FormResponse {
  id              String             @id @default(uuid())
  formId          String
  respondentId    String?
  respondentEmail String
  respondentName  String?
  status          FormResponseStatus @default(SUBMITTED)
  answers         Json
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?
  submittedAt     DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  participant     EventParticipant?  @relation("ParticipantFormResponse")
  form            EventForm          @relation("FormResponses", fields: [formId], references: [id], onDelete: Cascade)
  respondent      User?              @relation("FormRespondent", fields: [respondentId], references: [id])
  reviewedBy      User?              @relation("FormResponseReviewer", fields: [reviewedById], references: [id])

  @@index([formId])
  @@index([respondentId])
  @@index([respondentEmail])
  @@index([status])
  @@index([submittedAt])
}

model FormTemplate {
  id          String      @id @default(uuid())
  name        String
  description String?
  purpose     FormPurpose
  questions   Json        @default("[]")
  isBuiltIn   Boolean     @default(false)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   User?       @relation("TemplateCreator", fields: [createdById], references: [id])

  @@index([purpose])
  @@index([createdById])
  @@index([isBuiltIn])
}

model EventParticipant {
  id             String            @id @default(uuid())
  eventId        String
  userId         String?
  type           ParticipantType
  status         ParticipantStatus @default(INVITED)
  name           String
  email          String
  phone          String?
  company        String?
  bio            String?
  website        String?
  linkedin       String?
  twitter        String?
  avatarUrl      String?
  metadata       Json?
  customType     String?
  formResponseId String?           @unique
  addedById      String
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  addedBy        User              @relation("ParticipantAdder", fields: [addedById], references: [id])
  event          Event             @relation("EventParticipants", fields: [eventId], references: [id], onDelete: Cascade)
  formResponse   FormResponse?     @relation("ParticipantFormResponse", fields: [formResponseId], references: [id])
  reviewedBy     User?             @relation("ParticipantReviewer", fields: [reviewedById], references: [id])
  user           User?             @relation("ParticipantUser", fields: [userId], references: [id])

  @@index([eventId])
  @@index([type])
  @@index([status])
  @@index([email])
  @@index([userId])
  @@index([addedById])
}

model ContactQuery {
  id            String                 @id @default(cuid())
  name          String
  email         String
  subject       String
  message       String
  status        SupportQueryStatus     @default(NEW)
  priority      SupportPriority        @default(MEDIUM)
  assignedTo    String?
  resolvedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  assignedAgent User?                  @relation("AssignedContactQueries", fields: [assignedTo], references: [id])
  responses     ContactQueryResponse[]

  @@index([status])
  @@index([priority])
  @@index([email])
  @@index([createdAt])
}

model ContactQueryResponse {
  id         String       @id @default(cuid())
  queryId    String
  response   String
  sentBy     String
  isInternal Boolean      @default(false)
  sentAt     DateTime     @default(now())
  query      ContactQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  agent      User         @relation("ContactQueryResponses", fields: [sentBy], references: [id])

  @@index([queryId])
  @@index([sentBy])
}

model Issue {
  id                 String            @id @default(cuid())
  number             Int               @unique @default(autoincrement())
  title              String
  type               IssueType         @default(BUG)
  status             IssueStatus       @default(NOT_STARTED)
  priority           IssuePriority     @default(MEDIUM)
  storyPoints        IssueStoryPoints?
  userStoryAs        String?           @db.Text
  userStoryWant      String?           @db.Text
  userStorySoThat    String?           @db.Text
  description        String?           @db.Text
  needToKnow         String?           @db.Text
  workNotes          String?           @db.Text
  acceptanceCriteria Json?
  tags               String[]
  dueDate            DateTime?
  kanbanOrder        Float             @default(0)
  createdById        String
  assigneeId         String?
  templateId         String?
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  reporter           User              @relation("IssueReporter", fields: [createdById], references: [id])
  assignee           User?             @relation("IssueAssignee", fields: [assigneeId], references: [id])
  template           IssueTemplate?    @relation(fields: [templateId], references: [id])
  activities         IssueActivity[]
  attachments        IssueAttachment[]
  subtasks           IssueSubtask[]
  comments           IssueComment[]
  blockedBy          Issue[]           @relation("IssueBlocking")
  blocking           Issue[]           @relation("IssueBlocking")

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([createdById])
  @@index([dueDate])
  @@index([status, kanbanOrder])
  @@index([type])
  @@index([deletedAt])
}

model IssueComment {
  id         String   @id @default(cuid())
  issueId    String
  content    String
  isInternal Boolean  @default(false)
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  author     User     @relation("IssueCommentAuthor", fields: [authorId], references: [id])
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([authorId])
}

model IssueSubtask {
  id        String  @id @default(cuid())
  issueId   String
  title     String
  completed Boolean @default(false)
  order     Int     @default(0)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issueId])
}

model IssueActivity {
  id        String              @id
  issueId   String
  actorId   String
  action    IssueActivityAction
  fromValue String?
  toValue   String?
  meta      Json?
  createdAt DateTime            @default(now())
  actor     User                @relation(fields: [actorId], references: [id])
  issue     Issue               @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([issueId])
}

model IssueAttachment {
  id           String   @id
  issueId      String
  url          String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime @default(now())
  issue        Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([issueId])
}

model IssueTemplate {
  id                  String        @id
  name                String
  userStoryTemplate   String?
  descriptionTemplate String?
  workNotesTemplate   String?
  defaultType         IssueType     @default(TASK)
  defaultPriority     IssuePriority @default(MEDIUM)
  defaultTags         String[]
  isBuiltIn           Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime
  Issue               Issue[]
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN_STAFF
  MARKETER
  SUPPORT
  TELLER
  ORGANIZER
  ORGANIZER_STAFF
  ORGANIZER_TELLER
  ATTENDEE
}

enum UserStatus {
  ACTIVE // User account is active and can use the platform fully
  SUSPENDED // Admin action: User is banned (punitive) - cannot login or use platform
  DEACTIVATED // User self-deactivated or admin soft-deleted (non-punitive) - can login but cannot perform actions, can be reactivated
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum EventStatus {
  PENDING // Waiting for admin approval
  APPROVED // Approved by admin, visible to public
  REJECTED // Rejected by admin
  CANCELLED // Cancelled by organizer
  COMPLETED // Event has ended
}

enum EventType {
  PUBLIC // Public event, visible to all
  PRIVATE // Private event, invite-only
}

enum RegistrationStatus {
  PENDING // Registration pending (no payment yet)
  CONFIRMED // Registration confirmed (payment completed or free event)
  CANCELLED // Registration cancelled
}

enum InviteType {
  ATTENDEE // General attendee registration
  SPEAKER // Speaker registration/invitation
  EXHIBITOR // Exhibitor registration/invitation
  GUEST // Guest/VIP invitation
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String? // Optional - users can set password later in profile
  firstName          String? // Optional - can be added in profile
  lastName           String? // Optional - can be added in profile
  otherName          String? // Middle name or other names
  phoneNumber        String?
  companyAffiliation String? // Company or institutional affiliation
  role               UserRole   @default(ATTENDEE)
  status             UserStatus @default(ACTIVE)
  isEmailVerified    Boolean    @default(false)
  emailVerifiedAt    DateTime?

  // Organizer-specific fields (optional - can be added later)
  organizationName String?
  businessEmail    String?

  // Organization relationship (Option A: managedBy field)
  managedBy     String? // User ID of organizer/admin who manages this user
  managedByUser User?   @relation("ManagedUsers", fields: [managedBy], references: [id], onDelete: SetNull)
  managedUsers  User[]  @relation("ManagedUsers")

  // KYC fields (for organizers)
  kycStatus      KYCStatus?
  kycSubmittedAt DateTime?
  kycApprovedAt  DateTime?

  // Verification levels (progressive verification system)
  isIdentityVerified Boolean   @default(false) // Level 2: Identity verified (can create paid events with limits)
  identityVerifiedAt DateTime?
  payoutLimit        Decimal?  @db.Decimal(10, 2) // Monthly payout limit (null = unlimited, requires full KYC)
  verificationLevel   Int       @default(1) // 1=Basic, 2=Identity Verified, 3=Full KYC

  // Security fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  // Relations
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  kycDocuments       KYCDocument[]
  auditLogs          AuditLog[]
  eventsCreated      Event[]             @relation("EventOrganizer")
  eventRegistrations EventRegistration[]
  invitationsCreated EventInvitation[]  @relation("InvitationCreator")
  templatesCreated   TicketTemplate[]   @relation("TemplateCreator")
  featuredEventsCreated FeaturedEvent[]  @relation("FeaturedEventCreator")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([managedBy])
  @@index([organizationName])
}

model RefreshToken {
  id            String    @id @default(uuid())
  token         String    @unique
  userId        String
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  revoked       Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model EmailVerification {
  id         String    @id @default(uuid())
  userId     String?
  email      String    // Store email for code-based verification before user creation
  code       String?   // 6-digit verification code
  token      String?   @unique // Token for link-based verification (backward compatibility)
  role       UserRole? // Store selected role during registration
  expiresAt  DateTime
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([email])
  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model KYCDocument {
  id              String    @id @default(uuid())
  userId          String
  documentType    String // BUSINESS_LICENSE, TAX_ID, etc.
  documentNumber  String?
  documentUrl     String?
  status          KYCStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String? // User, Event, etc.
  entityId  String?
  metadata  Json? // Additional data
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String   @db.Text
  fullDescription String?  @db.Text
  category        String?
  tags            String[] // Array of tags

  // Dates and times
  startDate            DateTime
  endDate              DateTime?
  startTime            String? // Time string (e.g., "09:00 AM")
  endTime              String? // Time string (e.g., "05:00 PM")
  registrationDeadline DateTime?

  // Location
  venue       String?
  location    String // City, State or full address
  address     String? // Full street address
  isOnline    Boolean @default(false)
  onlineLink  String?
  coordinates Json? // { lat: number, lng: number }

  // Pricing
  isFree      Boolean  @default(false)
  price       Decimal? @db.Decimal(10, 2) // Single price for simple events
  ticketTypes Json? // Array of ticket types with prices

  // Capacity
  capacity       Int? // Total capacity (null = unlimited)
  availableSlots Int? // Calculated available slots

  // Media
  image  String? // Image URL
  images String[] // Array of image URLs

  // Event details
  type           EventType   @default(PUBLIC)
  status         EventStatus @default(PENDING)
  requirements   String[] // Array of requirements
  ageRestriction String? // e.g., "18+", "All Ages"
  duration       String? // e.g., "8 hours", "3 days"

  // Additional content
  speakers           Json? // Array of speakers
  sponsors           Json? // Array of sponsors
  faqs               Json? // Array of FAQs
  registrationFields Json? // Custom registration form fields

  // Organizer
  organizerId String
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  // Admin approval
  approvedBy      String? // Admin user ID who approved
  approvedAt      DateTime?
  rejectedBy      String? // Admin user ID who rejected
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  // Audit fields
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  // Relations
  registrations EventRegistration[]
  invitations    EventInvitation[]
  ticketTemplates TicketTemplate[]
  featuredEvents FeaturedEvent[]

  @@index([organizerId])
  @@index([status])
  @@index([category])
  @@index([startDate])
  @@index([isFree])
  @@index([deletedAt])
  @@index([createdAt])
}

model EventRegistration {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  attendeeId String
  attendee   User   @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  // Registration link tracking
  invitationId String? // Link used for registration (if registered via invitation link)
  invitation   EventInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  // Registration details
  ticketType  String? // Ticket type name if multiple ticket types
  quantity    Int     @default(1)
  totalAmount Decimal @db.Decimal(10, 2) // Total amount paid (0 for free events)

  // Registration form data
  registrationData Json? // Custom form data submitted by attendee

  // Status
  status RegistrationStatus @default(PENDING)

  // Payment (for future implementation)
  paymentStatus        String? // PENDING, COMPLETED, FAILED, REFUNDED
  paymentMethod        String? // STRIPE, PAYPAL, etc.
  paymentTransactionId String?

  // Audit fields
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  cancelledBy String?

  @@unique([eventId, attendeeId]) // One registration per attendee per event
  @@index([eventId])
  @@index([attendeeId])
  @@index([status])
  @@index([createdAt])
}

model EventInvitation {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Invitation details
  inviteType InviteType // Type of invitation (ATTENDEE, SPEAKER, EXHIBITOR, GUEST)
  token      String     @unique // Unique shareable token for the registration link
  title      String? // Optional custom title for the link
  description String? @db.Text // Optional description

  // Link settings
  expiresAt DateTime? // Optional expiration date
  maxUses   Int? // Optional maximum number of uses (null = unlimited)
  usedCount Int  @default(0) // Track how many times the link has been used
  isActive  Boolean @default(true) // Whether the link is active

  // Organizer who created this invitation
  createdBy String
  creator   User   @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revokedAt DateTime?
  revokedBy String?

  // Relations
  registrations EventRegistration[]

  @@index([eventId])
  @@index([token])
  @@index([inviteType])
  @@index([isActive])
  @@index([createdAt])
}

model TicketTemplate {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Template metadata
  name        String   // Template name
  description String?  @db.Text
  isDefault   Boolean  @default(false) // Whether this is the default template for the event

  // Template design
  backgroundUrl String? // Background image URL
  width        Int?    // Template width in pixels
  height       Int?    // Template height in pixels
  unit         String? // Unit: 'px', 'mm', 'in' (default: 'px')

  // Template elements (JSON array of elements)
  elements     Json?   // Array of template elements (text, image, QR code, etc.)

  // Created by
  createdBy    String
  creator      User    @relation("TemplateCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([eventId])
  @@index([createdBy])
  @@index([isDefault])
  @@index([createdAt])
}

model FeaturedEvent {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Display customization
  customTitle    String? // Optional custom title (defaults to event.title)
  customImage    String? // Optional custom hero image (defaults to event.image)
  customCategory String? // Optional custom category (defaults to event.category)
  
  // Display dates - when this featured event should be shown
  displayStartDate DateTime? // When to start showing this featured event
  displayEndDate   DateTime? // When to stop showing this featured event

  // Display order
  displayOrder Int     @default(0) // Lower numbers appear first
  isActive     Boolean @default(true) // Whether this featured event is active

  // Admin who created this featured event
  createdBy String
  creator   User   @relation("FeaturedEventCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([eventId])
  @@index([createdBy])
  @@index([isActive])
  @@index([displayOrder])
  @@index([displayStartDate])
  @@index([displayEndDate])
  @@index([createdAt])
}

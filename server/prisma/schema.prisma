// ============================================
// Seating & Venue Map Models
// ============================================

enum SeatStatus {
  AVAILABLE // Seat is available for booking
  RESERVED // Seat is temporarily reserved (in cart)
  BOOKED // Seat is booked/assigned
  BLOCKED // Seat is blocked (not available)
  MAINTENANCE // Seat is under maintenance
}

enum SeatType {
  STANDARD // Standard seat
  VIP // VIP seat
  PREMIUM // Premium seat
  WHEELCHAIR // Wheelchair accessible
  COMPANION // Companion seat (for wheelchair users)
  STANDING // Standing area
}

model Venue {
  id          String @id @default(uuid())
  organizerId String
  organizer   User   @relation("OrganizerVenues", fields: [organizerId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  coordinates Json? // { lat: number, lng: number }

  // Venue details
  capacity  Int? // Total capacity
  venueType String? // "theatre", "stadium", "conference", "hall", etc.
  amenities String[] // Array of amenities

  // Default seating configuration
  defaultSeatMap Json? // Default seat map layout (can be overridden per event)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  seatMaps SeatMap[]

  @@index([organizerId])
  @@index([isActive])
  @@index([venueType])
}

model SeatMap {
  id      String  @id @default(uuid())
  eventId String  @unique
  event   Event   @relation("EventSeatMap", fields: [eventId], references: [id], onDelete: Cascade)
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)

  // Seat map configuration
  name   String? // Custom name for this seat map
  layout Json // Seat map layout configuration (sections, rows, seats)
  // Layout structure:
  // {
  //   sections: [
  //     {
  //       id: "section-1",
  //       name: "Orchestra",
  //       type: "seated",
  //       rows: [
  //         {
  //           id: "row-A",
  //           label: "A",
  //           seats: [
  //             { id: "A1", label: "1", type: "STANDARD", price: 50.00 },
  //             { id: "A2", label: "2", type: "VIP", price: 100.00 }
  //           ]
  //         }
  //       ]
  //     }
  //   ]
  // }

  // Pricing by section/type
  pricing Json? // Pricing configuration per section/seat type

  // Display settings
  imageUrl String? // Venue map image URL
  width    Int? // Map width in pixels
  height   Int? // Map height in pixels

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  seats Seat[]

  @@index([eventId])
  @@index([venueId])
  @@index([isActive])
}

model Seat {
  id        String  @id @default(uuid())
  seatMapId String
  seatMap   SeatMap @relation(fields: [seatMapId], references: [id], onDelete: Cascade)

  // Seat identification
  seatIdentifier String // Unique identifier (e.g., "A1", "Section1-RowA-Seat1")
  sectionId      String? // Section ID from layout
  rowId          String? // Row ID from layout
  rowLabel       String? // Row label (e.g., "A", "1")
  seatLabel      String? // Seat label (e.g., "1", "2")

  // Seat properties
  seatType SeatType   @default(STANDARD)
  status   SeatStatus @default(AVAILABLE)

  // Pricing
  basePrice    Decimal? @db.Decimal(10, 2) // Base price for this seat
  currentPrice Decimal? @db.Decimal(10, 2) // Current price (may differ from base due to dynamic pricing)

  // Position (for visual rendering)
  x     Float? // X coordinate on map
  y     Float? // Y coordinate on map
  angle Float? // Rotation angle (for curved rows)

  // Metadata
  metadata Json? // Additional seat properties (aisle, restricted view, etc.)

  // Relations
  reservations SeatReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seatMapId, seatIdentifier])
  @@index([seatMapId])
  @@index([status])
  @@index([seatType])
  @@index([sectionId, rowId])
}

model SeatReservation {
  id             String            @id @default(uuid())
  seatId         String
  seat           Seat              @relation(fields: [seatId], references: [id], onDelete: Cascade)
  registrationId String            @unique
  registration   EventRegistration @relation("SeatReservation", fields: [registrationId], references: [id], onDelete: Cascade)

  // Reservation details
  reservedAt    DateTime  @default(now())
  reservedUntil DateTime? // For temporary reservations (cart timeout)
  confirmedAt   DateTime? // When reservation was confirmed (payment completed)

  // Pricing at time of reservation
  priceAtReservation Decimal @db.Decimal(10, 2)

  // Status
  status String @default("reserved") // "reserved", "confirmed", "cancelled"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seatId])
  @@index([registrationId])
  @@index([status])
  @@index([reservedUntil])
}


{
  "name": "eventknit-server",
  "version": "1.0.0",
  "description": "EventKnit Backend API Server",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "npm run prisma:migrate:deploy && node dist/server.js",
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx --watch src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:run": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "pre-push": "npm run prisma:generate && npm run lint && npm run type-check && npm run test:run && npm run build",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "postinstall": "node scripts/prisma-generate.js",
    "prisma:generate": "node scripts/prisma-generate.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "list-users": "node scripts/list-users.js",
    "delete-user": "node scripts/delete-user.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "repository": {
    "type": "git",

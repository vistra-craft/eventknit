# Environment Variables Configuration Template
# Copy this file to .env.development and update with your actual values
# Note: .env.development is the primary config file for development

# Server Configuration
NODE_ENV=development
PORT=3010
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://eventknit:YOUR_PASSWORD@postgres:5432/eventknit?schema=public"
POSTGRES_USER=eventknit
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=eventknit
POSTGRES_PORT=5432

# For local connections (outside Docker), use:
# DATABASE_URL="postgresql://eventknit:YOUR_PASSWORD@localhost:5432/eventknit?schema=public"

# JWT Configuration
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-long-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=noreply@eventknit.com

# OAuth Configuration
# Google OAuth (Get from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In (Get from https://developer.apple.com/account/resources/identifiers)
# Service ID (Client ID) - e.g., com.yourcompany.eventknit.web
APPLE_CLIENT_ID=com.yourcompany.eventknit.web
# Team ID - found in Apple Developer account
APPLE_TEAM_ID=YOUR_TEAM_ID
# Key ID - from your Apple Sign In Key
APPLE_KEY_ID=YOUR_KEY_ID
# Path to your Apple Sign In private key (.p8 file)
APPLE_PRIVATE_KEY_PATH=./keys/AuthKey_YOUR_KEY_ID.p8

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Security Configuration
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Redis Configuration (optional, for caching/sessions)
REDIS_URL=redis://redis:6379
REDIS_PORT=6380
REDIS_MAX_MEMORY=256mb

# Docker Configuration
VOLUME_MOUNT_SRC=./src
RESTART_POLICY=no
SERVER_REPLICAS=1

# PgAdmin Configuration (Development only)
PGADMIN_PORT=8080
PGADMIN_EMAIL=admin@eventknit.com
PGADMIN_PASSWORD=your-pgadmin-password

# Superadmin Seed (Optional)
SUPERADMIN_EMAIL=admin@eventknit.com
SUPERADMIN_PASSWORD=your-superadmin-password

# Logging
LOG_LEVEL=debug

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack Configuration (Payment Gateway)
# Get your keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=


# Client Environment Variables Configuration Template
# Copy this file to .env.local or .env and update with your actual values

# API Configuration
VITE_API_URL=http://localhost:3010/api/v1

# OAuth Configuration
# Google OAuth Client ID (Get from https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In Client ID (Service ID from https://developer.apple.com/account/resources/identifiers)
# This should match your web service identifier (e.g., com.yourcompany.eventknit.web)
VITE_APPLE_CLIENT_ID=com.yourcompany.eventknit.web

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
